/* ==========================================================================
   NexusPulse - gaya halaman
   Semua warna lewat CSS variable. Tema mengikuti prefers-color-scheme, dan
   bisa ditimpa manual lewat [data-tema] pada <html> (tombol di navbar).
   ========================================================================== */

:root {
  --bg: #f6f7fb;
  --bg-alt: #ffffff;
  --permukaan: #ffffff;
  --permukaan-2: #f0f2f8;
  --garis: #e2e5ee;
  --teks: #161a25;
  --teks-lembut: #5a6072;
  --teks-samar: #878ea1;
  --aksen: #4f46e5;
  --aksen-lembut: #eef0ff;
  --aksen-teks: #ffffff;
  --hijau: #16a34a;
  --merah: #dc2626;
  --bayang: 0 1px 2px rgba(20, 24, 40, 0.06), 0 8px 24px rgba(20, 24, 40, 0.06);
  --bayang-besar: 0 12px 40px rgba(20, 24, 40, 0.12);
  --radius: 14px;
  --radius-kecil: 10px;
  --lebar: 1180px;
  --transisi: 180ms ease;
}

/* Tema gelap otomatis. Diletakkan sebelum [data-tema] supaya pilihan manual
   di bawah selalu menang - itulah sebabnya keduanya memakai variabel yang sama,
   bukan dua blok media query terpisah. */
@media (prefers-color-scheme: dark) {
  :root:not([data-tema='terang']) {
    --bg: #0e1117;
    --bg-alt: #141924;
    --permukaan: #161c28;
    --permukaan-2: #1d2534;
    --garis: #262f40;
    --teks: #eef1f7;
    --teks-lembut: #a4adc0;
    --teks-samar: #7c869b;
    --aksen: #818cf8;
    --aksen-lembut: #1e2440;
    --aksen-teks: #0e1117;
    --hijau: #4ade80;
    --merah: #f87171;
    --bayang: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.3);
    --bayang-besar: 0 12px 40px rgba(0, 0, 0, 0.45);
  }
}

:root[data-tema='gelap'] {
  --bg: #0e1117;
  --bg-alt: #141924;
  --permukaan: #161c28;
  --permukaan-2: #1d2534;
  --garis: #262f40;
  --teks: #eef1f7;
  --teks-lembut: #a4adc0;
  --teks-samar: #7c869b;
  --aksen: #818cf8;
  --aksen-lembut: #1e2440;
  --aksen-teks: #0e1117;
  --hijau: #4ade80;
  --merah: #f87171;
  --bayang: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.3);
  --bayang-besar: 0 12px 40px rgba(0, 0, 0, 0.45);
}

*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--teks);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 { line-height: 1.2; margin: 0; letter-spacing: -0.02em; }
p { margin: 0; }
a { color: inherit; text-decoration: none; }
img, svg { display: block; max-width: 100%; }

.container {
  width: 100%;
  max-width: var(--lebar);
  margin: 0 auto;
  padding: 0 24px;
}
.container-sempit { max-width: 660px; }

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  z-index: 100;
  padding: 10px 16px;
  background: var(--aksen);
  color: var(--aksen-teks);
  border-radius: 0 0 var(--radius-kecil) 0;
}
.skip-link:focus { left: 0; }

/* --- tombol --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: var(--radius-kecil);
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  transition: transform var(--transisi), background var(--transisi), border-color var(--transisi), color var(--transisi);
  white-space: nowrap;
}
.btn-sm { padding: 8px 16px; font-size: 0.875rem; }
.btn-lg { padding: 13px 26px; font-size: 1rem; }
.btn-block { width: 100%; padding: 12px 20px; }
.btn-primary { background: var(--aksen); color: var(--aksen-teks); }
.btn-primary:hover { transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--teks); border-color: var(--garis); }
.btn-ghost:hover { background: var(--permukaan-2); }
.btn:focus-visible { outline: 2px solid var(--aksen); outline-offset: 2px; }

/* --- navbar --- */
.navbar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in srgb, var(--bg) 85%, transparent);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--garis);
}
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  height: 66px;
}
.logo {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 1.075rem;
  font-weight: 600;
  color: var(--aksen);
}
.logo span { color: var(--teks); }
.logo strong { color: var(--aksen); font-weight: 700; }

.nav-links { display: flex; gap: 26px; }
.nav-links a {
  font-size: 0.925rem;
  font-weight: 500;
  color: var(--teks-lembut);
  transition: color var(--transisi);
}
.nav-links a:hover { color: var(--teks); }

.nav-actions { display: flex; align-items: center; gap: 12px; }

.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  padding: 0;
  border: 1px solid var(--garis);
  border-radius: var(--radius-kecil);
  background: var(--permukaan);
  color: var(--teks-lembut);
  cursor: pointer;
  transition: color var(--transisi), border-color var(--transisi);
}
.theme-toggle:hover { color: var(--teks); }
.theme-toggle svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.ikon-bulan { display: none; }
:root[data-tema='gelap'] .ikon-matahari { display: none; }
:root[data-tema='gelap'] .ikon-bulan { display: block; }
@media (prefers-color-scheme: dark) {
  :root:not([data-tema='terang']) .ikon-matahari { display: none; }
  :root:not([data-tema='terang']) .ikon-bulan { display: block; }
}

/* --- hero --- */
.hero {
  padding: 86px 0 96px;
  background:
    radial-gradient(900px 380px at 50% -10%, var(--aksen-lembut), transparent 70%);
  text-align: center;
}
.hero-inner { display: flex; flex-direction: column; align-items: center; gap: 20px; }
.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 5px 14px 5px 10px;
  border: 1px solid var(--garis);
  border-radius: 999px;
  background: var(--permukaan);
  font-size: 0.815rem;
  font-weight: 600;
  color: var(--teks-lembut);
}
.badge-titik {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--hijau);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--hijau) 22%, transparent);
}
.hero h1 { font-size: clamp(2.1rem, 5.2vw, 3.5rem); max-width: 15ch; }
.aksen {
  background: linear-gradient(120deg, var(--aksen), color-mix(in srgb, var(--aksen) 55%, var(--teks)));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero-sub { max-width: 56ch; font-size: 1.075rem; color: var(--teks-lembut); }
.hero-aksi { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 6px; }
.hero-catatan { font-size: 0.84rem; color: var(--teks-samar); }

/* --- bagian umum --- */
.bagian { padding: 84px 0; }
.bagian-alt { background: var(--bg-alt); }
.bagian-kepala { text-align: center; max-width: 620px; margin: 0 auto 46px; }
.bagian-kepala h2 { font-size: clamp(1.65rem, 3.4vw, 2.3rem); margin-bottom: 12px; }
.bagian-sub { color: var(--teks-lembut); }

/* --- fitur --- */
.grid-fitur {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.kartu-fitur {
  padding: 26px 22px;
  background: var(--permukaan);
  border: 1px solid var(--garis);
  border-radius: var(--radius);
  box-shadow: var(--bayang);
  transition: transform var(--transisi), border-color var(--transisi);
}
.kartu-fitur:hover { transform: translateY(-3px); border-color: var(--aksen); }
.ikon-kotak {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin-bottom: 16px;
  border-radius: var(--radius-kecil);
  background: var(--aksen-lembut);
  color: var(--aksen);
}
.ikon-kotak svg { fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.kartu-fitur h3 { font-size: 1.06rem; margin-bottom: 8px; }
.kartu-fitur p { font-size: 0.925rem; color: var(--teks-lembut); }

/* --- dashboard demo --- */
.panel-demo {
  background: var(--permukaan);
  border: 1px solid var(--garis);
  border-radius: var(--radius);
  box-shadow: var(--bayang-besar);
  padding: 24px;
  overflow: hidden;
}
.tab-bar {
  display: inline-flex;
  gap: 4px;
  padding: 4px;
  margin-bottom: 26px;
  border-radius: var(--radius-kecil);
  background: var(--permukaan-2);
}
.tab {
  padding: 8px 22px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--teks-lembut);
  font: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--transisi), color var(--transisi);
}
.tab:hover { color: var(--teks); }
.tab.aktif { background: var(--permukaan); color: var(--aksen); box-shadow: var(--bayang); }
.tab:focus-visible { outline: 2px solid var(--aksen); outline-offset: 2px; }

.metrik-baris {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 30px;
}
.metrik { display: flex; flex-direction: column; gap: 3px; }
.metrik-label { font-size: 0.82rem; color: var(--teks-samar); font-weight: 500; }
.metrik-nilai { font-size: clamp(1.25rem, 2.4vw, 1.65rem); font-weight: 700; letter-spacing: -0.02em; }
.metrik-delta { font-size: 0.8rem; font-weight: 600; color: var(--teks-samar); }
.metrik-delta.naik { color: var(--hijau); }
.metrik-delta.turun { color: var(--merah); }

.grafik {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  height: 190px;
  padding-top: 10px;
  border-top: 1px solid var(--garis);
}
.batang {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 7px;
  height: 100%;
}
.batang-isi {
  width: 100%;
  border-radius: 7px 7px 3px 3px;
  background: linear-gradient(180deg, var(--aksen), color-mix(in srgb, var(--aksen) 55%, transparent));
  transition: height 420ms cubic-bezier(0.22, 0.8, 0.3, 1);
  min-height: 4px;
}
.batang-label {
  font-size: 0.71rem;
  color: var(--teks-samar);
  text-align: center;
  white-space: nowrap;
}
.grafik-catatan { margin-top: 14px; font-size: 0.82rem; color: var(--teks-samar); }

/* --- harga --- */
.toggle-harga {
  display: flex;
  justify-content: center;
  gap: 4px;
  padding: 4px;
  width: fit-content;
  margin: 0 auto 40px;
  border-radius: var(--radius-kecil);
  background: var(--permukaan-2);
}
.tombol-siklus {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 22px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--teks-lembut);
  font: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--transisi), color var(--transisi);
}
.tombol-siklus.aktif { background: var(--permukaan); color: var(--teks); box-shadow: var(--bayang); }
.hemat {
  padding: 2px 7px;
  border-radius: 999px;
  background: var(--aksen-lembut);
  color: var(--aksen);
  font-size: 0.7rem;
  font-weight: 700;
}

.grid-harga {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  align-items: start;
}
.kartu-harga {
  position: relative;
  padding: 30px 26px;
  background: var(--permukaan);
  border: 1px solid var(--garis);
  border-radius: var(--radius);
  box-shadow: var(--bayang);
}
.kartu-harga.populer {
  border-color: var(--aksen);
  box-shadow: var(--bayang-besar);
  transform: scale(1.03);
}
.label-populer {
  position: absolute;
  top: -11px;
  left: 50%;
  transform: translateX(-50%);
  padding: 4px 14px;
  border-radius: 999px;
  background: var(--aksen);
  color: var(--aksen-teks);
  font-size: 0.71rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}
.kartu-harga h3 { font-size: 1.15rem; margin-bottom: 6px; }
.harga-desk { font-size: 0.88rem; color: var(--teks-lembut); margin-bottom: 20px; }
.harga { display: flex; align-items: baseline; gap: 3px; margin-bottom: 22px; }
.harga-mata-uang { font-size: 0.95rem; font-weight: 600; color: var(--teks-lembut); }
.harga-angka { font-size: 2.05rem; font-weight: 700; letter-spacing: -0.03em; }
.harga-periode { font-size: 0.88rem; color: var(--teks-samar); }
.daftar-fitur { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 10px; }
.daftar-fitur li {
  position: relative;
  padding-left: 24px;
  font-size: 0.9rem;
  color: var(--teks-lembut);
}
.daftar-fitur li::before {
  content: '';
  position: absolute;
  left: 4px;
  top: 8px;
  width: 6px;
  height: 10px;
  border: solid var(--aksen);
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

/* --- form kontak --- */
.form-kontak { display: flex; flex-direction: column; gap: 18px; }
.baris-form { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.kolom-form { display: flex; flex-direction: column; gap: 6px; }
.kolom-form label { font-size: 0.875rem; font-weight: 600; }
.kolom-form input,
.kolom-form select,
.kolom-form textarea {
  width: 100%;
  padding: 11px 14px;
  border: 1px solid var(--garis);
  border-radius: var(--radius-kecil);
  background: var(--permukaan);
  color: var(--teks);
  font: inherit;
  font-size: 0.925rem;
  transition: border-color var(--transisi), box-shadow var(--transisi);
}
.kolom-form textarea { resize: vertical; min-height: 110px; }
.kolom-form input:focus,
.kolom-form select:focus,
.kolom-form textarea:focus {
  outline: none;
  border-color: var(--aksen);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--aksen) 18%, transparent);
}
.kolom-form input::placeholder,
.kolom-form textarea::placeholder { color: var(--teks-samar); }
.kolom-form input.galat,
.kolom-form select.galat,
.kolom-form textarea.galat { border-color: var(--merah); }
.pesan-galat {
  min-height: 0;
  font-size: 0.8rem;
  color: var(--merah);
  opacity: 0;
  transition: opacity var(--transisi);
}
.pesan-galat.tampil { opacity: 1; min-height: 18px; }

/* --- footer --- */
.footer { background: var(--bg-alt); border-top: 1px solid var(--garis); padding-top: 56px; }
.footer-inner {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 34px;
  padding-bottom: 40px;
}
.footer-kolom { display: flex; flex-direction: column; gap: 10px; }
.footer-kolom h4 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--teks-samar); }
.footer-kolom a { font-size: 0.9rem; color: var(--teks-lembut); }
.footer-kolom a:hover { color: var(--aksen); }
.footer-tagline { font-size: 0.9rem; color: var(--teks-lembut); max-width: 30ch; }
.status-layanan { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; color: var(--hijau); font-weight: 600; }
.titik-hijau {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--hijau);
  animation: denyut 2.2s ease-in-out infinite;
}
@keyframes denyut {
  0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--hijau) 45%, transparent); }
  50% { box-shadow: 0 0 0 6px transparent; }
}
.footer-bawah {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
  padding: 20px 24px;
  border-top: 1px solid var(--garis);
  font-size: 0.83rem;
  color: var(--teks-samar);
}

/* --- notifikasi --- */
.notifikasi {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 14px 20px;
  border: 1px solid var(--garis);
  border-radius: var(--radius-kecil);
  background: var(--permukaan);
  color: var(--teks);
  box-shadow: var(--bayang-besar);
  font-size: 0.9rem;
  font-weight: 500;
  transform: translateY(14px);
  opacity: 0;
  transition: transform 260ms ease, opacity 260ms ease;
}
.notifikasi.tampil { transform: translateY(0); opacity: 1; }
.notifikasi svg { fill: none; stroke: var(--hijau); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: none; }

/* --- responsif --- */
@media (max-width: 1000px) {
  .grid-fitur { grid-template-columns: repeat(2, 1fr); }
  .footer-inner { grid-template-columns: 1fr 1fr; }
  .kartu-harga.populer { transform: none; }
}

@media (max-width: 860px) {
  .nav-links { display: none; }
  .grid-harga { grid-template-columns: 1fr; gap: 18px; }
  .metrik-baris { grid-template-columns: repeat(2, 1fr); gap: 20px 16px; }
  .baris-form { grid-template-columns: 1fr; }
}

@media (max-width: 620px) {
  .container { padding: 0 18px; }
  .hero { padding: 60px 0 68px; }
  .bagian { padding: 62px 0; }
  .grid-fitur { grid-template-columns: 1fr; }
  .panel-demo { padding: 18px; }
  .tab { padding: 8px 14px; font-size: 0.84rem; }
  .grafik { gap: 6px; height: 160px; }
  .batang-label { font-size: 0.62rem; }
  .toggle-harga { width: 100%; }
  .tombol-siklus { flex: 1; justify-content: center; padding: 9px 12px; font-size: 0.84rem; }
  .footer-inner { grid-template-columns: 1fr; gap: 26px; }
  .footer-bawah { justify-content: flex-start; }
  .notifikasi { left: 18px; right: 18px; bottom: 18px; }
}

@media (max-width: 400px) {
  .hero h1 { font-size: 1.95rem; }
  .metrik-nilai { font-size: 1.2rem; }
  .btn-lg { padding: 12px 18px; font-size: 0.94rem; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
