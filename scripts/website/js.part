/* ==========================================================================
   NexusPulse - perilaku halaman
   Vanilla JS. Tanpa pustaka luar.
   ========================================================================== */

(function () {
  'use strict';

  /* --- data dashboard --- */
  /* Setiap rentang punya empat metrik, delta, dan tujuh titik grafiknya sendiri.
     Angka disimpan sebagai NILAI, bukan sebagai teks jadi - supaya pemformatnya
     satu tempat saja dan tidak ada string seperti "12.4rb" yang harus diurai
     ulang saat angkanya berubah. */
  var DATA = {
    harian: {
      catatan: 'Data harian, 7 titik terakhir.',
      metrik: [
        { label: 'Pengunjung', nilai: 12480, format: 'angka', delta: 8.4 },
        { label: 'Konversi', nilai: 3.42, format: 'persen', delta: 0.6 },
        { label: 'Pendapatan', nilai: 48200000, format: 'rupiah', delta: 12.1 },
        { label: 'Pengguna aktif', nilai: 3180, format: 'angka', delta: -2.3 }
      ],
      grafik: [42, 55, 38, 67, 58, 74, 61]
    },
    mingguan: {
      catatan: 'Data mingguan, 7 minggu terakhir.',
      metrik: [
        { label: 'Pengunjung', nilai: 86300, format: 'angka', delta: 15.2 },
        { label: 'Konversi', nilai: 3.98, format: 'persen', delta: 1.1 },
        { label: 'Pendapatan', nilai: 338400000, format: 'rupiah', delta: 21.7 },
        { label: 'Pengguna aktif', nilai: 11240, format: 'angka', delta: 6.8 }
      ],
      grafik: [38, 46, 52, 49, 63, 58, 71]
    },
    bulanan: {
      catatan: 'Data bulanan, 7 bulan terakhir.',
      metrik: [
        { label: 'Pengunjung', nilai: 372000, format: 'angka', delta: 34.9 },
        { label: 'Konversi', nilai: 4.31, format: 'persen', delta: 2.4 },
        { label: 'Pendapatan', nilai: 1470000000, format: 'rupiah', delta: 42.3 },
        { label: 'Pengguna aktif', nilai: 48900, format: 'angka', delta: 18.5 }
      ],
      grafik: [22, 34, 29, 45, 51, 47, 66]
    }
  };

  var LABEL_TITIK = {
    harian: ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'],
    mingguan: ['M1', 'M2', 'M3', 'M4', 'M5', 'M6', 'M7'],
    bulanan: ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul']
  };

  /* --- pemformat angka --- */
  function angka(n) {
    return n.toLocaleString('id-ID');
  }

  /* Nilai besar diringkas supaya kolom metrik tidak melebar dan mendorong
     tetangganya. Ambangnya 1 juta, bukan 1000: "12,4 rb" untuk 12.480 tetap
     terbaca, sementara 48200000 menjadi "48,2 jt". */
  function ringkas(n) {
    if (n >= 1000000000) return (n / 1000000000).toFixed(1).replace('.', ',') + ' M';
    if (n >= 1000000) return (n / 1000000).toFixed(1).replace('.', ',') + ' jt';
    return angka(n);
  }

  function formatNilai(n, jenis) {
    if (jenis === 'rupiah') return 'Rp ' + ringkas(n);
    if (jenis === 'persen') return n.toFixed(2).replace('.', ',') + '%';
    return ringkas(n);
  }

  /* --- render dashboard --- */
  var grafikEl = document.getElementById('grafik');
  var catatanEl = document.getElementById('grafikCatatan');

  function gambarGrafik(titik, label) {
    if (!grafikEl) return;
    grafikEl.innerHTML = '';
    var maks = Math.max.apply(null, titik);

    titik.forEach(function (nilai, i) {
      var batang = document.createElement('div');
      batang.className = 'batang';

      var isi = document.createElement('div');
      isi.className = 'batang-isi';
      /* Tinggi sebagai persen dari titik tertinggi, disisakan 8% supaya batang
         tertinggi tidak menempel ke label di atasnya. */
      isi.style.height = Math.max(4, Math.round((nilai / maks) * 92)) + '%';
      isi.setAttribute('title', label[i] + ': ' + nilai);

      var teks = document.createElement('span');
      teks.className = 'batang-label';
      teks.textContent = label[i];

      batang.appendChild(isi);
      batang.appendChild(teks);
      grafikEl.appendChild(batang);
    });
  }

  function tampilkanRentang(kunci) {
    var d = DATA[kunci];
    if (!d) return;

    d.metrik.forEach(function (m, i) {
      var nilaiEl = document.getElementById('m' + (i + 1));
      var deltaEl = document.getElementById('d' + (i + 1));
      if (nilaiEl) nilaiEl.textContent = formatNilai(m.nilai, m.format);
      if (deltaEl) {
        var naik = m.delta >= 0;
        deltaEl.textContent = (naik ? '+' : '') + m.delta.toFixed(1).replace('.', ',') + '%';
        deltaEl.className = 'metrik-delta ' + (naik ? 'naik' : 'turun');
      }
    });

    gambarGrafik(d.grafik, LABEL_TITIK[kunci]);
    if (catatanEl) catatanEl.textContent = d.catatan;
  }

  var tabBar = document.querySelector('.tab-bar');
  if (tabBar) {
    tabBar.addEventListener('click', function (e) {
      var tab = e.target.closest('.tab');
      if (!tab) return;
      tabBar.querySelectorAll('.tab').forEach(function (t) {
        var aktif = t === tab;
        t.classList.toggle('aktif', aktif);
        t.setAttribute('aria-selected', aktif ? 'true' : 'false');
      });
      tampilkanRentang(tab.dataset.tab);
    });
  }

  tampilkanRentang('harian');

  /* --- toggle harga --- */
  var toggleHarga = document.querySelector('.toggle-harga');
  if (toggleHarga) {
    toggleHarga.addEventListener('click', function (e) {
      var tombol = e.target.closest('.tombol-siklus');
      if (!tombol) return;
      var siklus = tombol.dataset.siklus;

      toggleHarga.querySelectorAll('.tombol-siklus').forEach(function (b) {
        var aktif = b === tombol;
        b.classList.toggle('aktif', aktif);
        b.setAttribute('aria-pressed', aktif ? 'true' : 'false');
      });

      /* Harga diambil dari atribut data, jadi menambah paket baru cukup dengan
         menulis data-bulanan dan data-tahunan di HTML - tidak ada daftar harga
         kedua di JavaScript yang harus dijaga tetap sinkron. */
      document.querySelectorAll('.harga-angka').forEach(function (el) {
        var nilai = el.getAttribute(siklus === 'tahunan' ? 'data-tahunan' : 'data-bulanan');
        if (nilai) el.textContent = nilai;
      });
    });
  }

  /* --- tema --- */
  var themeToggle = document.getElementById('themeToggle');
  var mediaGelap = window.matchMedia('(prefers-color-scheme: dark)');

  function temaAktif() {
    var dipilih = document.documentElement.getAttribute('data-tema');
    if (dipilih) return dipilih;
    return mediaGelap.matches ? 'gelap' : 'terang';
  }

  function perbaruiTombolTema() {
    if (!themeToggle) return;
    var gelap = temaAktif() === 'gelap';
    themeToggle.setAttribute('aria-pressed', gelap ? 'true' : 'false');
    themeToggle.setAttribute('aria-label', gelap ? 'Ganti ke tema terang' : 'Ganti ke tema gelap');
  }

  if (themeToggle) {
    themeToggle.addEventListener('click', function () {
      var berikut = temaAktif() === 'gelap' ? 'terang' : 'gelap';
      document.documentElement.setAttribute('data-tema', berikut);
      perbaruiTombolTema();
    });
  }

  /* Tema yang belum pernah dipilih manual harus ikut berubah kalau setelan
     sistemnya berubah - kalau tidak, halaman tetap terang sampai di-reload. */
  mediaGelap.addEventListener('change', perbaruiTombolTema);
  perbaruiTombolTema();

  /* --- tahun di footer --- */
  var tahunEl = document.getElementById('tahun');
  if (tahunEl) tahunEl.textContent = String(new Date().getFullYear());

  /* --- notifikasi --- */
  var notifEl = document.getElementById('notifikasi');
  var notifTeks = document.getElementById('notifikasiTeks');
  var notifTimer = null;

  function notifikasi(pesan) {
    if (!notifEl || !notifTeks) return;
    notifTeks.textContent = pesan;
    notifEl.hidden = false;
    void notifEl.offsetWidth;
    notifEl.classList.add('tampil');

    if (notifTimer) clearTimeout(notifTimer);
    notifTimer = setTimeout(function () {
      notifEl.classList.remove('tampil');
      setTimeout(function () { notifEl.hidden = true; }, 300);
    }, 3200);
  }

  /* --- validasi form --- */
  var SURAT = /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;

  function pesanUntuk(nama) {
    return document.querySelector('.pesan-galat[data-untuk="' + nama + '"]');
  }

  function tandai(nama, pesan) {
    var kolom = document.getElementById(nama);
    var el = pesanUntuk(nama);
    if (kolom) kolom.classList.toggle('galat', Boolean(pesan));
    if (el) {
      el.textContent = pesan || '';
      el.classList.toggle('tampil', Boolean(pesan));
    }
  }

  function periksa() {
    var hasil = {};
    var nama = (document.getElementById('nama') || {}).value || '';
    var surel = (document.getElementById('surel') || {}).value || '';
    var kategori = (document.getElementById('kategori') || {}).value || '';
    var pesan = (document.getElementById('pesan') || {}).value || '';

    if (!nama.trim()) hasil.nama = 'Nama wajib diisi.';
    else if (nama.trim().length < 2) hasil.nama = 'Nama minimal 2 karakter.';

    if (!surel.trim()) hasil.surel = 'Surel wajib diisi.';
    else if (!SURAT.test(surel.trim())) hasil.surel = 'Format surel belum benar, contoh: nama@perusahaan.com';

    if (!kategori) hasil.kategori = 'Pilih salah satu kategori.';

    if (!pesan.trim()) hasil.pesan = 'Pesan wajib diisi.';
    else if (pesan.trim().length < 20) {
      hasil.pesan = 'Pesan minimal 20 karakter, sekarang ' + pesan.trim().length + '.';
    }

    return hasil;
  }

  var form = document.getElementById('formKontak');
  if (form) {
    /* Validasi saat mengetik, tapi hanya membersihkan galat - tidak menambah
       galat baru. Menampilkan galat saat pengguna baru mengetik huruf pertama
       membuat form terasa menuduh, jadi galat baru muncul saat submit atau
       saat kolomnya ditinggalkan. */
    form.addEventListener('input', function (e) {
      var id = e.target.id;
      if (id && pesanUntuk(id)) {
        var kolom = document.getElementById(id);
        if (kolom && !kolom.classList.contains('galat')) return;
        var h = periksa();
        tandai(id, h[id] || '');
      }
    });

    form.addEventListener('blur', function (e) {
      var id = e.target.id;
      if (!id || !pesanUntuk(id)) return;
      var h = periksa();
      if (h[id]) tandai(id, h[id]);
    }, true);

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var h = periksa();
      var namaKolom = ['nama', 'surel', 'kategori', 'pesan'];

      namaKolom.forEach(function (n) { tandai(n, h[n] || ''); });

      if (Object.keys(h).length > 0) {
        var pertama = document.getElementById(Object.keys(h)[0]);
        if (pertama) pertama.focus();
        return;
      }

      notifikasi('Terima kasih, pesan Anda sudah terkirim.');
      form.reset();
      namaKolom.forEach(function (n) { tandai(n, ''); });
    });
  }
})();
