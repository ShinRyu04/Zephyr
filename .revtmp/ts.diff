+}
+
+/*
+ * Permukaan kotak ketik - juga sisi bawah "kapsul" yang dibentuk bersama
+ * kartu tugas di atasnya (lihat ai-todo-card.css).
+ *
+ * Yang penting di sini HANYA dua baris pertama: sudut ATAS lurus dan border
+ * atas tetap ada. Kartu tugas mengapalkan border bawahnya sendiri dan
+ * meluruskan sudut bawahnya, jadi garis yang terlihat di antara keduanya adalah
+ * SATU garis milik komponen ini. Kalau baris itu ikut dibulatkan atau
+ * border atasnya dihapus, sambungannya putus dan mereka kembali terlihat
+ * sebagai dua kotak terpisah.
+ *
+ * Bagian kedua memakai .ai-input-row:not(:first-child): saat kartu tugas hadir,
+ * kotak ketik memang bukan anak pertama lagi, jadi border atas tadi dihapus
+ * supaya tidak ada garis dobel, dan sudut atasnya dibulatkan sedikit supaya
+ * tetap enak dilihat sendirian.
+ */
+/*
+ * The composer: the bottom row of the status run.
+ *
+ * Square top corners and a top border, so when a status stack sits above it the
+ * two share one seam exactly like the loop and the task list do inside the
+ * stack - flush, one 1px rule, no gap. The top border is what makes the seam
+ * visible; it is never removed.
+ *
+ * When the stack is absent (nothing running, no plan) this row is alone in the
+ * DOM, and `:first-child` below rounds all four corners so it still reads as a
+ * complete box rather than a lidless one.
+ *
+ * The side inset matches the stack's `10px`, so left and right edges line up.
+ */
+.ai-input-row {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 8px 10px;
+  margin: 0 10px;
+  border: 1px solid var(--border);
+  border-radius: 0 0 var(--ai-dock-radius, 10px) var(--ai-dock-radius, 10px);
+  background: var(--bg0);
+  flex: 0 0 auto;
+  transition: border-color 110ms ease, box-shadow 110ms ease;
+}
+
+/*
+ * One unified composer box, Copilot-style: the whole row lights its border on
+ * focus (via :focus-within) instead of the textarea carrying a second border
+ * inside the already-bordered row. That inner border was the "numpuk" / piled-up
+ * look the user reported — two nested boxes with a visible seam between the
+ * input and the toolbar.
+ */
+.ai-input-row:focus-within {
+  border-color: var(--accent);
+}
+
+/* Kotak ketik BERDIRI SENDIRI tanpa kartu di atasnya: jangan biarkan sudut
+   atasnya lurus, karena tidak ada apa pun yang menempel di sana. */
+/*
+ * No more special case for "a card sits above me".
+ *
+ * This rule used to delete the composer's top border whenever the task card was
+ * present, so the two boxes shared a single seam. Now that each is its own
+ * card with a gap between them, the border belongs to the composer always -
+ * otherwise the row loses its top edge exactly when a loop is running, which is
+ * the shape change the reader noticed.
+ */
+
+/*
+ * Alone in the DOM: round all four corners.
+ *
+ * `:first-child` is not enough on its own any more. The status stack and the
+ * composer are siblings, so when the stack IS present the composer is still a
+ * first-child only if nothing else precedes it - and the panel header does. The
+ * reliable test is what the browser actually needs to know: is there a stack
+ * directly above me? If not, this row is the whole capsule and gets its top
+ * corners back.
+ */
+.ai-input-row:not(.ai-work-stack + .ai-input-row) {
+  border-radius: var(--ai-dock-radius, 10px);
+}
+.ai-input {
+  flex: 1 1 auto;
+  resize: none;
+  min-height: 38px;
+  max-height: 140px;
+  /* A new line (Shift+Enter) automatically grows the box up to max-height —
+     without this the text overflows/scrolls and it looks like "you cannot make
+     a new line". field-sizing is supported by WebView2/Chrome 123+. */
+  field-sizing: content;
+  padding: 4px 4px 0;
+  font-family: var(--font-ui);
+  font-size: 13px;
+  line-height: 1.5;
+  color: var(--text);
+  /* Borderless and transparent: the textarea is part of the composer box, not
+     its own card. The row's :focus-within carries the focus ring now. */
+  background: transparent;
+  border: 0;
+}
+.ai-input:focus {
+  outline: none;
+}
+.ai-input::placeholder {
+  color: var(--text-muted);
+}
+.ai-input-side {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  align-items: stretch;
+  width: 132px;
+  flex: 0 0 auto;
+}
+/*
+ * Copilot-style composer toolbar: a horizontal row BELOW the textarea.
+ *
+ * The controls (+, mic, model, mode, permission, reasoning, send) now sit on
+ * one line under the input instead of in a 132px column beside it, so the
+ * textarea gets the full width and the bar reads like the reference composer.
+ * It wraps when the panel is narrow so no control is ever clipped.
+ */
+.ai-input-toolbar {
+  display: flex;
+  flex-direction: row;
+  align-items: center;
+  gap: 6px;
+  flex-wrap: wrap;
+  flex: 0 0 auto;
+  /* Pull the row a touch left so the leading "+" lines up under the textarea
+     text rather than sitting inset by its own icon padding. */
+  margin-left: -2px;
+}
+.ai-input-toolbar .ai-toolbar-spacer {
+  flex: 1 1 auto;
+}
+/* Bottom status bar: message count on the left, context ring on the right. */
+.ai-botbar {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 4px 8px;
+  margin: 4px 12px 0;
+  padding: 2px 2px 0;
+  font-size: 11px;
+  color: var(--text-secondary);
+}
+.ai-botbar .ai-botbar-spacer {
+  flex: 1 1 auto;
+}
+.ai-botbar .ai-count {
+  font-size: 11px;
+  color: var(--text-secondary);
+}
+/*
+ * The context popup lives in the BOTTOM bar now, so it must open UPWARD — the
+ * default downward rule put it below the window edge where it was invisible
+ * (the reported "context usage tidak nongol"). Scoped to the bottom bar so the
+ * meter still opens downward anywhere it sits at the top.
+ */
+.ai-botbar .ctx-pop {
+  top: auto;
+  bottom: calc(100% + 6px);
+}
+.ai-attach {
+  font-size: 10.5px;
+  padding: 3px 6px;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  color: var(--text-secondary);
+  text-align: center;
+}
+.ai-attach:hover:not(:disabled) {
+  color: var(--text);
+  background: var(--surface-2);
+}
+.ai-attach:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+.ai-attach.is-on {
+  color: var(--accent);
+  border-color: var(--accent);
+  background: var(--accent-subtle);
+}
+.ai-photo {
+  font-size: 12px;
+  padding: 2px 6px;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  color: var(--text-secondary);
+  text-align: center;
+  background: transparent;
+  cursor: pointer;
+}
+.ai-photo:hover {
+  color: var(--text);
+  background: var(--surface-2);
+}
+.ai-imgstrip {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-bottom: 6px;
+}
+.ai-msg-imgs {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-bottom: 6px;
+}
+/* Tool results inside the answer bubble (item 23).
+ *
+ * Flat like a chat log, not boxed like a panel.
+ *
+ * This started as a bordered card per call, then a left hairline group, and both
+ * read as furniture: three calls stacked into three stacked panels and pushed
+ * the actual answer around. Hermes-style is one quiet line per call — icon,
+ * verb, target, time — with the whole row as the click target and a soft hover
+ * to show it opens. Nothing else: no box, no border, no fill. */
+/*
+ * A tool row in the transcript has NO box.
+ *
+ * The reader's correction, and the reference agrees: in the reference every tool
+ * call in the transcript is a bare line - caret, prompt, name, chip - separated
+ * from the next by a hairline, with no border, no radius and no fill. The boxed
+ * card belongs INSIDE the status stack (the running/expanded view), not here.
+ * Twenty boxes in a conversation turns the transcript into a wall of frames;
+ * twenty lines read as a log.
+ */
+.ai-toolrun {
+  border: 0;
+  background: none;
+  overflow: hidden;
+  animation: ai-toolrun-in 180ms ease-out both;
+}
+/*
+ * The tool row, shaped like the reference's header line.
+ *
+ * Left to right: caret, green prompt, the action's name in bright text, then the
+ * target as a code chip. The name is the one bright thing on the row - it is
+ * what the reader scans for - while the chip and the trailing meta stay muted so
+ * a column of rows reads as a list of actions rather than as a wall of text.
+ */
+.ai-toolrun-head {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  width: 100%;
+  padding: 3px 6px;
+  border: 0;
+  border-radius: 6px;
+  background: none;
+  color: var(--text-muted);
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+  transition: background 110ms ease;
+}
+
+/* Rows arrive as they are appended, so they fade in - the same 180ms slide the
+   tool cards use, which keeps the two surfaces reading as one system. */
+.ai-toolrun {
+  animation: ai-toolrun-in 180ms ease-out both;
+}
+
+@keyframes ai-toolrun-in {
+  from {
+    opacity: 0;
+    transform: translateY(3px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ai-toolrun {
+    animation: none;
+  }
+}
+.ai-toolrun-head:hover {
+  background: var(--bg1);
+  color: var(--text);
+}
+.ai-toolrun-head:hover .ai-toolrun-args,
+.ai-toolrun-head:hover .ai-toolrun-ms {
+  color: var(--text);
+}
+/*
+ * Per-tool icon and the file chip.
+ *
+ * The row used to lead with the raw tool name — "editor_write" — which the
+ * reader has to translate before it means anything. The label comes from the
+ * shared action table (Read / Write / Run), and a call that edits a file shows
+ * the file itself, with a grip that echoes the drop-handle language used by the
+ * editor tabs.
+ */
+/*
+ * One accent colour for every tool glyph.
+ *
+ * The icons used to borrow four different syntax colours, which made a column
+ * of rows look like four unrelated things. They are all the same kind of thing
+ * — work the agent did — so they share one hue, and the shape alone says which
+ * action it was. Green is the convention every agent UI already uses for "this
+ * ran", and it is the only colour on an otherwise monochrome row, so the eye
+ * can follow the icon column straight down.
+ */
+/*
+ * The tool row's glyph: a terminal prompt in green.
+ *
+ * The reference leads every tool row with a green `>_` (terax-ai's tool card
+ * header), and the shape does two jobs at once - it says "a command ran" and it
+ * says which rows are actions rather than conversation, without the reader
+ * parsing a word. Zephyr drew a per-kind outline icon here, which was
+ * informative but read as decoration next to the green prompt in the reference:
+ * the column of identical green marks is what makes the transcript scannable.
+ *
+ * The per-kind colour still applies (see the `.is-*` rules below) - the shape is
+ * the prompt, the colour still carries the kind.
+ */
+.ai-toolrun-ikon {
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 14px;
+  height: 14px;
+  color: #3fb950;
+}
+
+/* A failed call takes the danger colour, icon included: the row has to be
+   findable in a long transcript without reading the words. */
+.ai-toolrun.is-gagal .ai-toolrun-ikon {
+  color: var(--danger);
+}
+
+/*
+ * The expanded body: an Input block and an Output block.
+ *
+ * Both use the same frame so the two read as a pair, and the labels are small
+ * uppercase because they are navigation, not content. The output block carries
+ * a tab strip and an exit badge when the tool reported one — a shell call is
+ * the case where the reader most needs to know whether it succeeded before
+ * reading a single line of it.
+ */
+.ai-io {
+  margin: 0 0 6px;
+}
+
+.ai-io-head {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 3px;
+}
+
+.ai-io-label {
+  color: var(--text-muted);
+  font-size: 9.5px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.ai-io-tabs {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  margin-left: auto;
+}
+
+.ai-io-tab {
+  padding: 1px 6px;
+  border-radius: 4px;
+  color: var(--text-muted);
+  font-family: var(--font-mono);
+  font-size: 10px;
+  opacity: 0.65;
+}
+
+/* The active stream is the one whose contents are on screen. */
+.ai-io-tab.is-on {
+  background: var(--surface-2);
+  color: var(--fg0);
+  opacity: 1;
+}
+
+.ai-io-exit {
+  flex-shrink: 0;
+  padding: 1px 6px;
+  border-radius: 4px;
+  font-family: var(--font-mono);
+  font-size: 10px;
+  font-variant-numeric: tabular-nums;
+}
+
+.ai-io-exit.is-ok {
+  background: color-mix(in srgb, #3fb950 18%, transparent);
+  color: #3fb950;
+}
+
+.ai-io-exit.is-err {
+  background: color-mix(in srgb, var(--danger) 20%, transparent);
+  color: var(--danger);
+}
+
+.ai-io-code {
+  margin: 0;
+  max-height: 240px;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--fg1);
+  font-family: var(--font-mono);
+  font-size: 11px;
+  line-height: 1.5;
+  overflow: auto;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+
+.ai-io-code.is-err {
+  color: var(--danger);
+}
+
+/*
+ * The one-line summary of what a call produced.
+ *
+ * "12 lines · 20.7KB" is metadata, not a headline: it sits after the target in
+ * the muted colour so the row still reads as verb-first, and it is the first
+ * thing dropped when the panel is narrow because the tool name and its target
+ * matter more than the count.
+ */
+/*
+ * The tool list's argument column.
+ *
+ * Muted and monospace so it reads as the thing the tool acts on rather than a
+ * second name, and truncated rather than wrapped: a wrapped row would change
+ * height and make the list impossible to scan.
+ */
+/*
+ * An item's handle, at the end of its row.
+ *
+ * Dim and monospace: it is there to be copied, not read, and it must not
+ * compete with the item's own text. It fades further on hover so the row's
+ * actions get the attention instead.
+ */
+/*
+ * The "how to use it" disclosure under Custom sub-agents.
+ *
+ * Collapsed by default: the section is about managing the list, and the
+ * instructions are reference material a reader needs once. The numbered list
+ * is the order the three routes exist in, and the code spans are the literal
+ * strings to type, so they are monospace and never translated.
+ */
+.subagent-cara {
+  margin: 6px 0 10px;
+  color: var(--text-muted);
+  font-size: 12px;
+}
+
+.subagent-cara summary {
+  cursor: pointer;
+  color: var(--fg0);
+  font-size: 12px;
+}
+
+.subagent-cara ol {
+  margin: 6px 0 4px;
+  padding-left: 20px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.subagent-cara code {
+  padding: 1px 4px;
+  border-radius: 3px;
+  background: var(--surface-2);
+  color: var(--fg0);
+  font-family: var(--font-mono);
+  font-size: 11px;
+}
+
+.subagent-cara-note {
+  margin: 4px 0 0;
+  opacity: 0.85;
+}
+
+.nt-id {
+  flex-shrink: 0;
+  max-width: 96px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  color: var(--text-muted);
+  font-family: var(--font-mono);
+  font-size: 9.5px;
+  opacity: 0.55;
+}
+
+.nt-row:hover .nt-id {
+  opacity: 0.85;
+}
+
+.tg-objek {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  color: var(--text-muted);
+  font-family: var(--font-mono);
+  font-size: 10.5px;
+  text-align: left;
+}
+
+.ai-toolrun-stat {
+  flex-shrink: 0;
+  color: var(--text-muted);
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+  opacity: 0.9;
+}
+
+/* Searching is the one action that is not a file or a command, so it keeps a
+   cooler green — enough to separate it in a list, not enough to compete. */
+.ai-toolrun-ikon.is-cari {
+  color: #2f9e6a;
+}
+
+/* Reasoning and memory are internal work, not actions on the project: they stay
+   dim so a long transcript's tool calls remain the thing that stands out. */
+.ai-toolrun-ikon.is-ingat {
+  color: color-mix(in srgb, #3fb950 55%, var(--text-muted));
+}
+
+/* The file name in a tool row: plain monospace text, not a chip.
+   A bordered pill here made every call look like a UI control; the reader only
+   needs the path, and the hover already signals the row is clickable. */
+.ai-file-chip {
+  display: inline-flex;
+  min-width: 0;
+  align-items: center;
+  gap: 4px;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--text);
+  font-family: var(--font-mono);
+  font-size: 11px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ai-file-chip-grip {
+  display: none;
+}
+
+/*
+ * The caret and the status bullet at the head of the row.
+ *
+ * The reference opens every tool line with a small solid dot whose colour IS
+ * the state - amber while running, green when done, red on failure - followed
+ * by the shell prompt. Zephyr had only the caret, so the state lived at the far
+ * end of the row (the elapsed time and the failure word) and a running call
+ * looked identical to a finished one when scanning down the left edge.
+ *
+ * The dot is 6px and sits before the prompt: it is the first thing the eye
+ * crosses on every row, which is exactly where a status marker belongs.
+ */
+.ai-toolrun-caret {
+  flex: none;
+  width: 8px;
+  color: var(--text-muted);
+  font-size: 8px;
+  opacity: 0.7;
+}
+
+.ai-toolrun-dot {
+  flex: none;
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--text-muted);
+}
+
+/* Done: a quiet outline - the call finished, nothing to look at. */
+.ai-toolrun-dot.is-beres {
+  background: transparent;
+  border: 1px solid var(--text-muted);
+}
+
+/* Running: solid amber and pulsing. The one state that changes, so the one
+   state that moves. */
+.ai-toolrun-dot.is-jalan {
+  background: var(--warning, #d29922);
+  animation: ai-dot-pulse 1.5s ease-in-out infinite;
+}
+
+/* Failed: solid red - the loudest mark in the column, deliberately. */
+.ai-toolrun-dot.is-gagal {
+  background: var(--danger);
+}
+
+@keyframes ai-dot-pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: .4; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ai-toolrun-dot.is-jalan {
+    animation: none;
+  }
+}
+
+/*
+ * Elapsed time for the call.
+ *
+ * Tinted with the same syntax green the thinking dots use for "finished work",
+ * monospaced so the digits stop jittering as values change, and pushed right by
+ * the flexible args column so the badge sits on a shared edge down the list.
+ */
+.ai-toolrun-ms {
+  flex: none;
+  margin-left: auto;
+  color: var(--text-muted);
+  font-family: var(--font-mono);
+  font-size: 10px;
+  font-variant-numeric: tabular-nums;
+  opacity: 0.75;
+}
+/*
+ * The action's name: the one bright thing on the row.
+ *
+ * The reference prints it in normal-weight bright text (`Open page`), while
+ * everything else on the line - the chip, the timing, the state word - is muted.
+ * That single bright element is what the eye lands on when scanning a column of
+ * calls, so the weight here is deliberate: 500, not 700, because bold at this
+ * size starts to compete with the message text above the transcript.
+ */
+.ai-toolrun-name {
+  flex: none;
+  color: var(--text);
+  font-size: 11px;
+  font-weight: 500;
+}
+/*
+ * The argument, drawn as a code chip.
+ *
+ * The reference wraps the call's target in a bordered pill with a monospace
+ * value inside (`Open page` + `[https://www.google.com]`), and the chip is the
+ * strongest shape on the row - it is how the reader tells the action's name
+ * from the thing it acted on. A bare muted string left the two running together
+ * as one sentence.
+ */
+.ai-toolrun-args {
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  padding: 1px 6px;
+  border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
+  border-radius: 5px;
+  background: var(--bg1);
+  color: var(--text-secondary);
+  font-family: var(--font-mono);
+  font-size: 10.5px;
+  line-height: 1.5;
+}
+/* A failed call stays quiet: one short word in the danger colour, sized like
+   the rest of the row. It used to be a pill with a tinted fill that pulled the
+   eye harder than the answer it belonged to. */
+.ai-toolrun-fail {
+  flex: none;
+  color: var(--danger, #d66);
+  font-size: 10px;
+  opacity: 0.9;
+}
+.ai-toolrun-out {
+  max-height: 260px;
+  overflow: auto;
+  margin: 0;
+  padding: 8px;
+  border-top: 1px solid var(--border);
+  font-size: 11px;
+  line-height: 1.45;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+.ai-toolrun-out.is-err {
+  color: var(--danger, #d66);
+}
+/* A-7: clickable file references in the answer text. */
+.ai-file-ref {
+  display: inline-block;
+  margin: 0 2px;
+  padding: 0 4px;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  background: var(--surface-2);
+  color: var(--accent);
+  font-family: var(--font-mono, monospace);
+  font-size: 0.92em;
+  cursor: pointer;
+}
+.ai-file-ref:hover {
+  border-color: var(--accent);
+  text-decoration: underline;
+}
+/*
+ * Tool call body: Input, Output, then the actions.
+ *
+ * The result used to sit in one unlabelled <pre> directly under the header, so
+ * a shell call showed an output with no visible command — you had to read the
+ * JSON in the collapsed row to know what ran. Two labelled sections make the
+ * pair explicit, and the actions moved to icon buttons on the right so the row
+ * reads as one control strip rather than three loose words.
+ */
+/*
+ * The expanded tool body is text, not a widget.
+ *
+ * It was a bordered card holding two bordered boxes, each with its own
+ * uppercase heading. Three levels of chrome around six lines of output made a
+ * transcript that read as a wall of panels. The body now sits flush under its
+ * own row: no frame, no fill, no headings — just the command in monospace and
+ * the result beneath it, indented to the row's text column so the eye can run
+ * straight down the left edge.
+ */
+.ai-toolrun-body {
+  margin: 0 0 6px 18px;
+  padding: 2px 0 0;
+}
+
+.ai-toolrun-in {
+  margin: 0 0 4px;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--text-muted);
+  font-family: var(--font-mono);
+  font-size: 11px;
+  line-height: 1.5;
+  overflow-x: auto;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+
+.ai-toolrun-out {
+  margin: 0;
+  max-height: 260px;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--fg1);
+  font-family: var(--font-mono);
+  font-size: 11px;
+  line-height: 1.5;
+  overflow: auto;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+
+.ai-toolrun-out.is-err {
+  color: var(--danger);
+}
+
+.ai-toolrun-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 3px 7px;
+  border: 1px solid transparent;
+  border-radius: 4px;
+  background: none;
+  color: var(--text-muted);
+  font: inherit;
+  font-size: 11px;
+  cursor: pointer;
+}
+
+.ai-toolrun-btn:hover {
+  border-color: var(--border);
+  background: var(--surface-2);
+  color: var(--fg0);
+}
+
+.ai-toolrun-act {
+  display: flex;
+  gap: 4px;
+  padding: 4px 6px 6px;
+  border-top: 1px solid var(--border);
+}
+.ai-imgpreview {
+  position: relative;
+  width: 88px;
+  margin-bottom: 6px;
+}
+.ai-imgpreview img {
+  width: 88px;
+  height: 66px;
+  object-fit: cover;
+  border-radius: 6px;
+  border: 1px solid var(--border);
+  display: block;
+}
+.ai-imgremove {
+  position: absolute;
+  top: -7px;
+  right: -7px;
+  width: 18px;
+  height: 18px;
+  border-radius: 50%;
+  border: 1px solid var(--border);
+  background: var(--surface-2);
+  color: var(--text);
+  font-size: 10px;
+  line-height: 1;
+  cursor: pointer;
+}
+.ai-msg-img {
+  max-width: 260px;
+  max-height: 180px;
+  border-radius: 8px;
+  border: 1px solid var(--border);
+  margin-bottom: 6px;
+  display: block;
+}
+.ai-panehint {
+  font-size: 9.5px;
+  color: var(--text-muted);
+  text-align: center;
+}
+
+/* ── dangerous command confirmation ── */
+.ai-confirm {
+  position: absolute;
+  left: 50%;
+  bottom: 66px;
+  transform: translateX(-50%);
+  z-index: 50;
+  width: min(520px, 92%);
+  padding: 10px 12px;
+  background: var(--surface-2);
+  border: 1px solid color-mix(in srgb, var(--danger) 55%, var(--border));
+  border-radius: var(--radius);
+  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
+}
+.ai-confirm-title {
+  font-size: 12px;
+  color: var(--danger);
+  margin-bottom: 6px;
+}
+.ai-confirm-cmd {
+  display: block;
+  font-family: var(--font-mono);
+  font-size: 11.5px;
+  color: var(--text);
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  padding: 6px 8px;
+  margin-bottom: 8px;
+  white-space: pre-wrap;
+  word-break: break-all;
+}
+.ai-confirm-btns {
+  display: flex;
+  gap: 8px;
+  justify-content: flex-end;
+}
+
+.ai-toast {
+  position: absolute;
+  right: 12px;
+  bottom: 66px;
+  z-index: 45;
+  font-size: 11.5px;
+  color: var(--text);
+  background: var(--surface-3);
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius);
+  padding: 5px 10px;
+  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.32);
+}
+
+/* ── AI sidebar ── */
+.ai-side-model {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-bottom: 8px;
+  font-size: 11.5px;
+  color: var(--text-secondary);
+}
+.ai-side-mname {
+  flex: 1 1 auto;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  color: var(--text);
+}
+.ai-side-key {
+  font-size: 10px;
+  border-radius: 9px;
+  padding: 1px 6px;
+  border: 1px solid var(--border);
+}
+.ai-side-key.is-ok {
+  color: var(--success);
+  border-color: color-mix(in srgb, var(--success) 45%, transparent);
+}
+.ai-side-key.is-warn {
+  color: var(--warning);
+  border-color: color-mix(in srgb, var(--warning) 55%, transparent);
+}
+
+.ai-side-list {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+/* A-9: the chat history search box. */
+.ai-side-search {
+  width: 100%;
+  margin-bottom: 6px;
+  padding: 4px 7px;
+  border: 1px solid var(--border);
+  border-radius: 5px;
+  background: var(--surface-2);
+  color: var(--text);
+  font-size: 12px;
+}
+.ai-side-search:focus {
+  outline: none;
+  border-color: var(--accent);
+}
+
+/* A-3: the quick chat menu from an editor selection. */
+.cm-ai-menu {
+  position: fixed;
+  z-index: 60;
+  display: flex;
+  flex-direction: column;
+  min-width: 132px;
+  padding: 3px;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  background: var(--surface-1);
+  box-shadow: 0 6px 20px rgb(0 0 0 / 35%);
+}
+.cm-ai-menu button {
+  padding: 5px 9px;
+  border: 0;
+  border-radius: 4px;
+  background: transparent;
+  color: var(--text);
+  font-size: 12px;
+  text-align: left;
+  cursor: pointer;
+}
+.cm-ai-menu button:hover {
+  background: var(--accent);
+  color: var(--accent-fg, #fff);
+}
+
+/* A-8: slash command suggestions above the input. */
+.ai-slash {
+  display: flex;
+  flex-direction: column;
+  /* 9 built-in prompts + user prompts can exceed this limit. The list scrolls
+     (rather than being cut off) so every option stays reachable; the keyboard arrows
+     follow the highlight via scrollIntoView in AiPanel. */
+  max-height: 220px;
+  margin-bottom: 4px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  background: var(--surface-1);
+  /* A thin scrollbar: this list appears above the input, and a thick scrollbar
+     makes the panel feel cramped. */
+  scrollbar-width: thin;
+  scrollbar-color: var(--border) transparent;
+}
+
+.ai-slash::-webkit-scrollbar {
+  width: 8px;
+}
+
+.ai-slash::-webkit-scrollbar-track {
+  background: transparent;
+}
+
+.ai-slash::-webkit-scrollbar-thumb {
+  background: var(--border);
+  border-radius: 4px;
+}
+
+.ai-slash::-webkit-scrollbar-thumb:hover {
+  background: var(--text-muted);
+}
+
+.ai-slash-item {
+  flex: 0 0 auto;
+}
+.ai-slash-item {
+  display: flex;
+  gap: 8px;
+  align-items: baseline;
+  padding: 4px 8px;
+  border: 0;
+  background: transparent;
+  color: var(--text);
+  font-size: 12px;
+  text-align: left;
+  cursor: pointer;
+}
+.ai-slash-item.is-on {
+  background: var(--surface-2);
+}
+.ai-slash-cmd {
+  color: var(--accent);
+  font-family: var(--font-mono, monospace);
+}
+.ai-slash-label {
+  color: var(--text-muted);
+  font-size: 11px;
+}
+
+/* A-4: the floating mini chat in the editor (Ctrl+I). It floats at the top right of the
+   editor area so it does not cover the line being worked on. */
+.ic {
+  position: absolute;
+  top: 8px;
+  right: 12px;
+  z-index: 55;
+  width: 380px;
+  max-width: calc(100% - 24px);
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-2, 6px);
+  padding: var(--sp-3, 10px);
+  border: 1px solid var(--border-strong);
+  border-radius: 8px;
+  background: var(--surface-1);
+  box-shadow: 0 10px 30px rgb(0 0 0 / 45%);
+}
+.ic-head {
+  display: flex;
+  align-items: center;
+}
+.ic-title {
+  flex: 1;
+  color: var(--text-secondary);
+  font-size: 11.5px;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+.ic-close {
+  border: 0;
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+.ic-close:hover {
+  color: var(--text);
+}
+.ic-hint {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: 11px;
+}
+.ic-input {
+  width: 100%;
+  padding: var(--sp-2, 6px);
+  border: 1px solid var(--border);
+  border-radius: 5px;
+  background: var(--input-bg, var(--surface-2));
+  color: var(--text);
+  font-family: inherit;
+  font-size: 12px;
+  resize: vertical;
+}
+.ic-input:focus {
+  outline: none;
+  border-color: var(--accent);
+}
+.ic-out {
+  max-height: 180px;
+  overflow: auto;
+  padding: var(--sp-2, 6px);
+  border: 1px solid var(--border);
+  border-radius: 5px;
+  background: var(--surface-2);
+  color: var(--text);
+  font-size: 11.5px;
+  line-height: 1.5;
+  white-space: pre-wrap;
+}
+.ic-foot {
+  display: flex;
+  justify-content: flex-end;
+}
+
+/* A-6: a diff preview before "Apply" overwrites the tab contents. */
+.ai-diff {
+  margin-top: 6px;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  overflow: hidden;
+  background: var(--surface-1);
+}
+.ai-diff-head {
+  display: flex;
+  gap: 6px;
+  align-items: center;
+  padding: 4px 8px;
+  border-bottom: 1px solid var(--border);
+  background: var(--surface-2);
+}
+.ai-diff-sum {
+  flex: 1;
+  color: var(--text-muted);
+  font-size: 11px;
+}
+.ai-diff-body {
+  max-height: 320px;
+  overflow: auto;
+  font-family: var(--font-mono, monospace);
+  font-size: 11.5px;
+  line-height: 1.5;
+}
+.ai-diff-row {
+  display: flex;
+  gap: 6px;
+  padding: 0 6px;
+  white-space: pre;
+}
+/*
+ * Diff rows, in the convention every developer already reads.
+ *
+ * Green means added, red means removed — the same pairing git uses, so the
+ * colour needs no legend. The tint is deliberately light: the row still has to
+ * be readable as code, and a saturated fill would fight the syntax colours
+ * inside it. The +/- marker carries the meaning for anyone who cannot see the
+ * colour difference, so nothing here depends on hue alone.
+ */
+.ai-diff-row.is-add {
+  background: color-mix(in srgb, var(--success, #2e7d32) 18%, transparent);
+}
+.ai-diff-row.is-add .ai-diff-sign {
+  color: var(--success, #3fb950);
+}
+.ai-diff-row.is-del {
+  background: color-mix(in srgb, var(--danger, #c62828) 18%, transparent);
+}
+.ai-diff-row.is-del .ai-diff-sign {
+  color: var(--danger, #f85149);
+}
+.ai-diff-no {
+  flex: 0 0 34px;
+  color: var(--text-muted);
+  text-align: right;
+  user-select: none;
+}
+.ai-diff-sign {
+  flex: 0 0 10px;
+  color: var(--text-muted);
+}
+.ai-diff-text {
+  flex: 1;
+  min-width: 0;
+}
+
+.ai-side-item {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+.ai-side-btn {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  flex: 1 1 auto;
+  min-width: 0;
+  padding: 4px 6px;
+  border-radius: 4px;
+  text-align: left;
+  color: var(--text-secondary);
+  font-size: 11.5px;
+}
+.ai-side-btn:hover {
+  background: var(--surface-2);
+  color: var(--text);
+}
+/*
+ * Row delete.
+ *
+ * The row used to end in the word "delete" in muted grey, which cost width in a
+ * narrow sidebar and read as a label rather than a control. An icon keeps the
+ * row steady, and it stays invisible until hover so a stray click cannot wipe a
+ * conversation — the same rule the session switcher follows.
+ */
+.ai-side-del {
+  display: flex;
+  flex: 0 0 auto;
+  align-items: center;
+  justify-content: center;
+  width: 20px;
+  height: 20px;
+  border: none;
+  border-radius: 4px;
+  background: none;
+  color: var(--text-muted);
+  cursor: pointer;
+  opacity: 0;
+  transition: opacity 120ms ease, color 120ms ease, background 120ms ease;
+}
+
+.ai-side-item:hover .ai-side-del,
+.ai-side-btn.is-active + .ai-side-del,
+.ai-side-del:focus-visible {
+  opacity: 1;
+}
+
+.ai-side-del:hover {
+  background: color-mix(in srgb, var(--danger) 18%, transparent);
+  color: var(--danger);
+}
+
+/*
+ * The meta line sits under the title, not beside it.
+ *
+ * Title and meta on one line meant a long title squeezed "3 messages · 02:40"
+ * down to an ellipsis, so the row lost the one piece of information that tells
+ * two same-named chats apart. Scoped to this list: the generic `.btn` rule a
+ * few lines up is not involved, so the New chat button keeps its icon beside
+ * the label rather than above it.
+ */
+.ai-side-list .ai-side-btn {
+  flex-direction: column;
+  align-items: stretch;
+  gap: 1px;
+}
+
+.ai-side-btn > svg {
+  display: none;
+}
+
+.ai-side-title {
+  font-size: 11.5px;
+}
+
+.ai-side-meta {
+  font-size: 9.5px;
+}
+
+.ai-side-btn.is-active {
+  background: var(--accent-subtle);
+  color: var(--text);
+}
+/* The title row + the "Delete all" button are in line. The button itself uses
+   .tp-op (thin border, red hover) — consistent with the per-chat delete button
+   in the list below it. */
+.ai-side-head-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 6px;
+}
+.ai-side-clear {
+  flex: 0 0 auto;
+}
+.ai-side-title {
+  flex: 1 1 auto;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.ai-side-meta {
+  font-size: 9.5px;
+  color: var(--text-muted);
+  flex: 0 0 auto;
+}
+
+/* ── agent mode ── */
+
+.ai-mode {
+  display: flex;
+  gap: 2px;
+  border: 1px solid var(--border);
+  border-radius: 5px;
+  padding: 2px;
+  flex: 0 0 auto;
+}
+
+.ai-mode-btn {
+  background: none;
+  border: none;
+  color: var(--text-muted);
+  font: inherit;
+  font-size: 11px;
+  line-height: 1;
+  padding: 4px 9px;
+  border-radius: 3px;
+  cursor: pointer;
+}
+
+.ai-mode-btn:hover {
+  color: var(--text);
+}
+
+.ai-mode-btn.is-on {
+  background: var(--accent);
+  color: var(--text-on-accent, #fff);
+}
+
+.ai-approval {
+  background: var(--bg-panel);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: 5px;
+  font: inherit;
+  font-size: 11px;
+  padding: 3px 5px;
+  flex: 0 0 auto;
+}
+
+/* T1.2/T1.5: the AI path selector row (Native vs CLI). */
+.ai-cli-bar {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  flex-wrap: wrap;
+  padding: 4px 10px;
+  border-bottom: 1px solid var(--border);
+  background: var(--bg-panel);
+}
+
+.ai-cli-chip {
+  background: transparent;
+  color: var(--text-muted);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  font: inherit;
+  font-size: 10.5px;
+  padding: 2px 9px;
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.ai-cli-chip:hover:not(:disabled) {
+  color: var(--text);
+  border-color: var(--text-muted);
+}
+
+.ai-cli-chip.is-on {
+  color: var(--accent);
+  border-color: var(--accent);
+}
+
+.ai-cli-chip:disabled {
+  opacity: 0.45;
+  cursor: not-allowed;
+}
+
+.ai-cli-chip.is-off {
+  text-decoration: line-through;
+  text-decoration-thickness: 1px;
+}
+
+.ai-cli-warn {
+  color: var(--warn, #d29922);
+}
+
+.ai-cli-hint {
+  font-size: 10.5px;
+  color: var(--text-muted);
+  font-style: italic;
+  margin-left: auto;
+}
+
+/* T1.1: the "Reasoned" block — the model's reasoning, collapsible. */
+/*
+ * The reasoning row.
+ *
+ * One line, no box, no fill — the same shape as a tool row, because both are
+ * things the agent did and neither deserves to look like a card. The header is
+ * the whole control: clicking it opens the thinking underneath. The body is
+ * dimmer and slightly narrower than the answer, which is the honest hierarchy —
+ * the reasoning explains the answer, it is not the answer.
+ */
+.ai-reason {
+  margin: 2px 0 6px;
+}
+
+.ai-reason-head {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  width: 100%;
+  padding: 2px 0;
+  border: 0;
+  background: none;
+  color: var(--text-muted);
+  font: inherit;
+  font-size: 12px;
+  text-align: left;
+  cursor: pointer;
+}
+
+.ai-reason-head:hover {
+  color: var(--fg0);
+}
+
+.ai-reason-title {
+  font-weight: 500;
+}
+
+/*
+ * A live shimmer while the model is thinking.
+ *
+ * This is the one animation in the transcript that carries information rather
+ * than decoration: a static "Thinking" beside a growing block of text is
+ * indistinguishable from a run that has died, and the reader has no way to tell
+ * "the model is still working" from "this hung thirty seconds ago".
+ *
+ * The gradient sweeps across the TEXT rather than pulsing its opacity. A pulse
+ * reads as a blinking light — an alarm — while a sweep reads as something moving
+ * through the line under its own power, which is what is actually happening. The
+ * band is wide and the cycle slow enough to be calm at a glance.
+ */
+.ai-reason[data-live='1'] .ai-reason-title {
+  /*
+   * Colour survives even if the clip is ignored.
+   *
+   * `-webkit-text-fill-color: transparent` makes the text INVISIBLE when
+   * `background-clip: text` is not honoured — and "Thinking" disappearing while
+   * the model works is worse than no animation at all. So the element keeps a
+   * real colour, and only the clipped variant clears the fill; a browser that
+   * ignores the clip renders the plain colour instead of nothing.
+   */
+  color: var(--fg0, #e6edf3);
+  background-image: linear-gradient(
+    90deg,
+    var(--text-muted, #8b949e) 0%,
+    var(--text-muted, #8b949e) 35%,
+    var(--fg0, #e6edf3) 50%,
+    var(--text-muted, #8b949e) 65%,
+    var(--text-muted, #8b949e) 100%
+  );
+  background-size: 220% 100%;
+  -webkit-background-clip: text;
+  background-clip: text;
+  animation: ai-reason-shimmer 1.9s linear infinite;
+}
+/* The fill is cleared only once the clip is known to apply. */
+@supports (background-clip: text) or (-webkit-background-clip: text) {
+  .ai-reason[data-live='1'] .ai-reason-title {
+    -webkit-text-fill-color: transparent;
+  }
+}
+@keyframes ai-reason-shimmer {
+  from { background-position: 140% 0; }
+  to { background-position: -40% 0; }
+}
