+  padding: 10px var(--ai-chat-pad-x) 34px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  /*
+   * Never let the transcript collapse to nothing.
+   *
+   * Short panel, tall card: with `min-height: 0` the flex row squeezed the
+   * scroller below one card and pushed the action row out of the panel
+   * entirely, where it could not be scrolled to.
+   */
+  min-height: 120px;
