+   * width where the CLI tab correctly hides it — the two transcripts behaving
+   * differently at the same size.
+   */
+  container-type: inline-size;
+  container-name: clilog;
+  /*
+   * Bottom padding reserves room for the last card's action row.
+   *
+   * The composer overlaps this scroller, so a tool card expanded at the end of
+   * the transcript had its Copy row hidden behind the input box — the buttons
+   * existed, and elementFromPoint proved they could not be hit. The reserved
+   * space is one action row plus a margin, not a guess.
