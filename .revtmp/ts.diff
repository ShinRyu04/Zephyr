+ */
+.ai-reason[data-live='1'] .ai-reason-body::after {
+  content: '▍';
+  margin-left: 1px;
+  color: var(--accent, #58a6ff);
+  animation: ai-reason-blink 1s step-end infinite;
+}
+@keyframes ai-reason-blink {
+  0%, 50% { opacity: 1; }
+  50.01%, 100% { opacity: 0.15; }
+}
+
+/* Respect a reader who has asked for less motion: keep the state legible
