+                      <span><AiIkon name="rocket" size={13} /> {tr('Ultracode')}</span>
+                      <span className={`cli-switch${o.ultracode ? ' is-on' : ''}`} aria-hidden="true" />
+                    </button>
+                  </>
+                )}
