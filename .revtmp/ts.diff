+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+}
+.cdx-shelf-empty { font-size: 12px; color: var(--text-muted); font-style: italic; }
+
+.cdx-hist-list {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  max-height: 220px;
+  overflow-y: auto;
+}
+.cdx-hist-row { display: flex; align-items: center; gap: 2px; border-radius: 6px; }
+.cdx-hist-row.is-on { background: var(--surface-3); }
+.cdx-hist-pick {
