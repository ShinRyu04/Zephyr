+    if (!sel) {
+      setBody('');
+      return;
+    }
+    let alive = true;
+    ccCatalogBody(sel.id).then((b) => alive && setBody(b)).catch(() => alive && setBody(''));
+    return () => {
+      alive = false;
+    };
+  }, [sel]);
+
+  const mine = items.filter((i) => i.kind === kind);
+  const needle = q.trim().toLowerCase();
+  const shown = needle
+    ? mine.filter(
