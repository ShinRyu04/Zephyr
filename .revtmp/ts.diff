+  display: flex;
+  align-items: center;
+  gap: 2px;
+  flex: 0 0 auto;
+  padding: 7px 10px;
+}
+
+.cdx-topbar-spacer { flex: 1 1 auto; }
+
+.cdx-top-btn {
+  display: inline-flex;
+  padding: 6px;
+  border: 0;
+  border-radius: 7px;
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+.cdx-top-btn:hover { background: var(--surface-3); color: var(--text); }
+.cdx-top-btn.is-on { background: var(--surface-3); color: var(--text); }
+
