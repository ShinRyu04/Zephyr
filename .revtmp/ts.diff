+          </div>
+
+          {/* Model chip → "Select a model" picker */}
+          <div className="cli-pop-wrap">
+            <button
+              className="cli-native-model cli-pop-trigger"
+              data-testid={`ai-clichat-model-${agentId}`}
+              aria-haspopup="menu"
+              aria-expanded={menu === 'model'}
+              onClick={() => setMenu((m) => (m === 'model' ? null : 'model'))}
+            >
