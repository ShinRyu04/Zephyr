+/* codex.css — Codex TUI (Codex tab only), mirroring the real Codex desktop app.
+   A dark canvas with a centred terminal glyph, a floating composer, an
+   approval/model/work bar, and a standalone Codex Settings page. All colour
+   comes from theme tokens; --cdx-accent is Codex green, set inline in the TSX.
+   Loaded after ai.css so these rules win where a class name is shared. */
+
+.ai-cli-host.is-codex {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  flex: 1 1 auto;
+}
+
+.cdx-native {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  flex: 1 1 auto;
+  background: var(--bg);
+}
+
+/* ── Top-right toolbar ── */
