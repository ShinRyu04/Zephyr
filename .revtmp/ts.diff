+  width: 200px;
+  padding: 14px 10px;
+  border-right: 1px solid var(--border);
+  overflow-y: auto;
+}
+.cdx-settings-navitem {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 12px;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-secondary);
+  font-size: 13px;
+  text-align: left;
+  cursor: pointer;
+}
+.cdx-settings-navitem:hover { background: var(--surface-2); color: var(--text); }
+.cdx-settings-navitem.is-on { background: var(--surface-3); color: var(--text); }
+
+.cdx-settings-pane {
+  flex: 1 1 auto;
+  min-width: 0;
+  overflow-y: auto;
+  padding: 24px 28px;
+  max-width: 720px;
+}
+.cdx-pane-h1 { margin: 0 0 6px; font-size: 24px; font-weight: 600; color: var(--text); }
+.cdx-pane-h2 { margin: 26px 0 10px; font-size: 15px; font-weight: 600; color: var(--text); }
+.cdx-h2-row, .cdx-h1-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.cdx-h1-actions { justify-content: flex-end; }
+.cdx-pane-desc { margin: 0 0 14px; font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }
+
+.cdx-card {
+  display: flex;
+  flex-direction: column;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  background: var(--surface);
+  overflow: hidden;
+}
+.cdx-card-row { flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; padding: 16px; }
+.cdx-card-empty { gap: 3px; padding: 16px; }
+
+.cdx-set-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px; }
+.cdx-set-row + .cdx-set-row { border-top: 1px solid var(--border); }
+.cdx-set-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
+.cdx-set-label { font-size: 13.5px; color: var(--text); }
+.cdx-set-sub { font-size: 12px; color: var(--text-muted); line-height: 1.45; }
+
+.cdx-select, .cdx-btn {
+  flex: 0 0 auto;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 7px 12px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--surface-2);
+  color: var(--text);
+  font-size: 12.5px;
+  cursor: pointer;
+}
+.cdx-btn:hover { background: var(--surface-3); }
+.cdx-btn-ghost { background: transparent; color: var(--text-muted); }
+.cdx-btn-danger { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 40%, var(--border)); }
+.cdx-btn-danger:hover { background: color-mix(in srgb, var(--danger) 14%, transparent); }
+
+.cdx-icon-btn {
+  display: inline-flex;
+  padding: 6px;
+  border: 0;
+  border-radius: 7px;
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+.cdx-icon-btn:hover { background: var(--surface-3); color: var(--text); }
+
+.cdx-seg { display: inline-flex; flex: 0 0 auto; padding: 2px; border-radius: 8px; background: var(--surface-2); }
+.cdx-seg-btn {
+  padding: 5px 12px;
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--text-muted);
+  font-size: 12.5px;
+  cursor: pointer;
+}
+.cdx-seg-btn.is-on { background: var(--surface-3); color: var(--text); }
+
+.cdx-switch {
+  position: relative;
+  flex: 0 0 auto;
+  width: 38px;
+  height: 22px;
+  padding: 0;
+  border: 0;
+  border-radius: 999px;
+  background: var(--surface-3);
+  cursor: pointer;
+  transition: background 120ms ease;
+}
+.cdx-switch.is-on { background: var(--cdx-accent, var(--accent)); }
+.cdx-switch-knob {
+  position: absolute;
+  top: 2px;
+  left: 2px;
+  width: 18px;
+  height: 18px;
+  border-radius: 50%;
+  background: #fff;
+  transition: transform 120ms ease;
+}
+.cdx-switch.is-on .cdx-switch-knob { transform: translateX(16px); }
+
+.cdx-instructions {
+  width: 100%;
+  resize: vertical;
+  min-height: 120px;
+  padding: 12px 14px;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  background: var(--surface);
+  color: var(--text);
+  font-family: var(--font-ui);
+  font-size: 13px;
+  line-height: 1.5;
+  outline: none;
+}
+.cdx-instructions:focus {
+  border-color: color-mix(in srgb, var(--cdx-accent, var(--accent)) 55%, var(--border));
+}
+
+.cdx-pill-row { display: flex; gap: 8px; margin-bottom: 6px; }
+.cdx-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 10px;
+  border-radius: 8px;
+  background: var(--surface-2);
+  color: var(--text-secondary);
+  font-size: 12px;
+}
