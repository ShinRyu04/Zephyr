+  await new Promise((r) => setTimeout(r, 1000));
+  const s = await ev(`(()=>{const st=window.__ZEPHYR_AI__.store.getState();
+    const m=(st.activeSession()||{}).messages||[];
+    const last=[...m].reverse().find(x=>x.role==='assistant');
+    if(!last) return null;
