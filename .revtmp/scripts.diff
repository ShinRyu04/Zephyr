diff --git a/scripts/build-cc-catalog.mjs b/scripts/build-cc-catalog.mjs
new file mode 100644
index 0000000..e17b301
--- /dev/null
+++ b/scripts/build-cc-catalog.mjs
@@ -0,0 +1,153 @@
+// Build the bundled Claude Code catalog (subagents + skills) that Zephyr ships
+// and can install into ~/.claude so the real `claude` CLI picks them up.
+//
+// Sources (downloaded + extracted under a dir passed as argv[2]):
+//   - 0xfurai/claude-code-subagents          -> agents/*.md
+//   - VoltAgent/awesome-claude-code-subagents -> categories/<cat>/*.md
+//   - anthropics/skills                       -> skills/<name>/SKILL.md
+//
+// Output: src-tauri/assets/cc-catalog.json — one array of entries:
+//   { id, kind:'agent'|'skill', name, title, description, source, category,
+//     model?, tools?, body }   (body = the full markdown to write to disk)
+//
+// Run: node scripts/build-cc-catalog.mjs /tmp/cc-probe/dl
+import { readFileSync, writeFileSync, readdirSync, statSync, existsSync } from 'node:fs';
+import { join } from 'node:path';
+
+const root = process.argv[2];
+if (!root) {
+  console.error('usage: node build-cc-catalog.mjs <extracted-dir>');
+  process.exit(1);
+}
+
+/** Parse YAML-ish frontmatter (--- ... ---) from a markdown doc. */
+function frontmatter(md) {
+  const m = md.match(/^---\n([\s\S]*?)\n---\n?/);
+  if (!m) return { meta: {}, body: md };
+  const meta = {};
+  for (const line of m[1].split('\n')) {
+    const i = line.indexOf(':');
+    if (i < 0) continue;
+    const k = line.slice(0, i).trim();
+    let v = line.slice(i + 1).trim();
+    if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) {
+      v = v.slice(1, -1);
+    }
+    if (k) meta[k] = v;
+  }
+  return { meta, body: md };
+}
+
+/** Title-case a kebab/snake name: "bash-expert" -> "Bash Expert". */
+function titleCase(name) {
+  return name
+    .replace(/[-_]+/g, ' ')
+    .replace(/\b\w/g, (c) => c.toUpperCase());
+}
+
+function onlyDir(base) {
+  // The tarball extracts to <repo>-<sha>/… ; return that single child.
+  const kids = readdirSync(base).filter((d) => statSync(join(base, d)).isDirectory());
+  return join(base, kids[0]);
+}
+
+const out = [];
+const seen = new Set();
+function push(e) {
+  // De-dupe by id, preferring the first (0xfurai is more uniform).
+  if (seen.has(e.id)) return;
+  seen.add(e.id);
+  out.push(e);
+}
+
+// --- 0xfurai subagents -----------------------------------------------------
+{
+  const dir = join(onlyDir(join(root, 'ex_furai')), 'agents');
+  for (const f of readdirSync(dir).filter((x) => x.endsWith('.md'))) {
+    const md = readFileSync(join(dir, f), 'utf8');
+    const { meta, body } = frontmatter(md);
+    const name = meta.name || f.replace(/\.md$/, '');
+    push({
+      id: `agent:${name}`,
+      kind: 'agent',
+      name,
+      title: titleCase(name),
+      description: meta.description || '',
+      source: '0xfurai/claude-code-subagents',
+      category: 'Experts',
+      model: meta.model || '',
+      tools: meta.tools || '',
+      body,
+    });
+  }
+}
+
+// --- VoltAgent subagents (grouped by category folder) ----------------------
+{
+  const catsRoot = join(onlyDir(join(root, 'ex_volt')), 'categories');
+  for (const cat of readdirSync(catsRoot)) {
+    const catDir = join(catsRoot, cat);
+    if (!statSync(catDir).isDirectory()) continue;
+    const pretty = titleCase(cat.replace(/^\d+-/, ''));
+    for (const f of readdirSync(catDir).filter((x) => x.endsWith('.md') && x !== 'README.md')) {
+      const md = readFileSync(join(catDir, f), 'utf8');
+      const { meta, body } = frontmatter(md);
+      const name = meta.name || f.replace(/\.md$/, '');
+      push({
+        id: `agent:${name}`,
+        kind: 'agent',
+        name,
+        title: titleCase(name),
+        description: meta.description || '',
+        source: 'VoltAgent/awesome-claude-code-subagents',
+        category: pretty,
+        model: meta.model || '',
+        tools: meta.tools || '',
+        body,
+      });
+    }
+  }
+}
+
+// --- anthropics/skills ------------------------------------------------------
+{
+  const skillsRoot = join(onlyDir(join(root, 'ex_skills')), 'skills');
+  for (const name of readdirSync(skillsRoot)) {
+    const skDir = join(skillsRoot, name);
+    const skFile = join(skDir, 'SKILL.md');
+    if (!existsSync(skFile)) continue;
+    const md = readFileSync(skFile, 'utf8');
+    const { meta, body } = frontmatter(md);
+    // Note extra resource files (templates/scripts) so the UI can hint them.
+    const extras = [];
+    const walk = (d, rel) => {
+      for (const e of readdirSync(d)) {
+        if (e === 'SKILL.md') continue;
+        const p = join(d, e);
+        const r = rel ? `${rel}/${e}` : e;
+        if (statSync(p).isDirectory()) walk(p, r);
+        else extras.push(r);
+      }
+    };
+    walk(skDir, '');
+    push({
+      id: `skill:${name}`,
+      kind: 'skill',
+      name: meta.name || name,
+      title: titleCase(meta.name || name),
+      description: meta.description || '',
+      source: 'anthropics/skills',
+      category: 'Skills',
+      extras: extras.slice(0, 40),
+      body,
+    });
+  }
+}
+
+out.sort((a, b) => (a.kind + a.category + a.name).localeCompare(b.kind + b.category + b.name));
+const dest = join(process.cwd(), 'src-tauri', 'assets', 'cc-catalog.json');
+writeFileSync(dest, JSON.stringify(out));
+const agents = out.filter((e) => e.kind === 'agent').length;
+const skills = out.filter((e) => e.kind === 'skill').length;
+console.log(`wrote ${out.length} entries (${agents} agents, ${skills} skills) -> ${dest}`);
+console.log(`size: ${(JSON.stringify(out).length / 1024 / 1024).toFixed(2)} MB`);
diff --git a/scripts/measure-run.mjs b/scripts/measure-run.mjs
new file mode 100644
index 0000000..3e461cd
--- /dev/null
+++ b/scripts/measure-run.mjs
@@ -0,0 +1,71 @@
+/*
+ * Measure one live agent run: every tool call, its duration, the payload size
+ * of each request, and any HTTP failure.
+ *
+ * The payload number is the point. A 502 from the gateway is a SIZE problem
+ * before it is anything else — the request grows with every tool result that
+ * stays in the conversation, so the failure arrives at a size, not at a step.
+ * Knowing which step crossed what size is what turns "it just 502s" into
+ * something fixable.
+ *
+ * Run it WHILE a run is in progress:  node scripts/measure-run.mjs
+ */
+import WebSocket from 'ws';
+
+const list = await (await fetch('http://127.0.0.1:9223/json/list')).json();
+const pg = list.find((x) => x.type === 'page');
+if (!pg) { console.error('no page'); process.exit(1); }
+const ws = new WebSocket(pg.webSocketDebuggerUrl, { perMessageDeflate: false });
+await new Promise((r) => ws.once('open', r));
+let id = 0;
+const send = (m, p = {}) => new Promise((res) => {
+  const i = ++id;
+  const h = (raw) => { const j = JSON.parse(raw); if (j.id === i) { ws.off('message', h); res(j); } };
+  ws.on('message', h);
+  ws.send(JSON.stringify({ id: i, method: m, params: p }));
+});
+const ev = async (e) => {
+  const r = await send('Runtime.evaluate', { expression: e, returnByValue: true });
+  if (r.result?.exceptionDetails) return null;
+  return r.result?.result?.value;
+};
+await send('Runtime.enable');
+
+/* The captured requests carry the payload size, host and status — never the
+   body of a successful call, and never a credential. */
+const probe = `(()=>{try{
+  const S=window.__ZEPHYR_AI__; if(!S) return null;
+  const st=S.getState(); const m=(st.activeSession()||{}).messages||[];
+  const tools=[];
+  for(const x of m) for(const p of (x.tools||[])) tools.push({
+    name:p.name, ok:!!p.ok, ms:p.ms||null,
+    insize:(typeof p.result==='string'?p.result.length:0),
+    outsize:(typeof p.args==='string'?p.args.length:0),
+  });
+  let bytes=0; try { bytes = JSON.stringify(m).length; } catch(e) {}
+  const last=[...m].reverse().find(x=>x.role==='assistant');
+  return JSON.stringify({toolCount:tools.length, tools, historyChars:bytes,
+    err:(last&&last.error)||'', streaming:!!(last&&last.streaming), answer:((last&&last.content)||'').length});
+}catch(e){ return null; }})()`;
+
+let seen = 0;
+const t0 = Date.now();
+for (let i = 0; i < 300; i++) {
+  const s = await ev(probe);
+  if (s) {
+    const j = JSON.parse(s);
+    while (seen < j.tools.length) {
+      const t = j.tools[seen];
+      const secs = Math.round((Date.now() - t0) / 1000);
+      console.log(`[${secs}s] #${seen + 1} ${t.name.padEnd(18)} ${t.ok ? 'ok ' : 'GAGAL'} ${String(t.ms ?? '-').padStart(6)}ms  hasil=${t.insize}B`);
+      seen++;
+    }
+    if (j.err) console.log(`❌ ERROR: ${j.err.slice(0, 300)}`);
+    if (j.toolCount > 0 && !j.streaming && j.answer > 0) {
+      console.log(`\n=== SELESAI: ${j.toolCount} tool, riwayat ${(j.historyChars / 1024).toFixed(1)}KB, jawaban ${j.answer} char ===`);
+      break;
+    }
+  }
+  await new Promise((r) => setTimeout(r, 2000));
+}
+ws.close();
