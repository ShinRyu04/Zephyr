@@ -0,0 +1,455 @@
+//! Bundled Claude Code catalog: subagents + skills, and installing them into
+//! the real `~/.claude/` so the live CLI picks them up (genuine sync, Cara B).
+//!
+//! Zephyr ships a catalog compiled into the binary (`assets/cc-catalog.json`,
+//! built by `scripts/build-cc-catalog.mjs` from the upstream repos:
+//! 0xfurai/claude-code-subagents, VoltAgent/awesome-claude-code-subagents and
+//! anthropics/skills). The slash popups ("Manage plugins" / Agents / Skills)
+//! browse this catalog and INSTALL a chosen entry by writing its markdown to:
+//!   * agents -> ~/.claude/agents/<name>.md
+//!   * skills -> ~/.claude/skills/<name>/SKILL.md
+//! which is exactly where the CLI reads user-scope agents/skills from, so an
+//! install is live the next terminal run too — not a Zephyr-only copy.
+
+use serde::{Deserialize, Serialize};
+
+use crate::errors::{ZResult, ZephyrError};
+
+/// One catalog entry: an agent or a skill, with its full markdown body.
+#[derive(Debug, Clone, Deserialize, Serialize)]
+pub struct CatalogEntry {
+    pub id: String,
+    pub kind: String, // "agent" | "skill"
+    pub name: String,
+    pub title: String,
+    #[serde(default)]
+    pub description: String,
+    #[serde(default)]
+    pub source: String,
+    #[serde(default)]
+    pub category: String,
+    #[serde(default)]
+    pub model: String,
+    #[serde(default)]
+    pub tools: String,
+    #[serde(default)]
+    pub extras: Vec<String>,
+    pub body: String,
+}
+
+/// A lighter row for the browser list — everything but the (large) body, plus
+/// whether the entry is already installed in `~/.claude`.
+#[derive(Debug, Clone, Serialize)]
+pub struct CatalogItem {
+    pub id: String,
+    pub kind: String,
+    pub name: String,
+    pub title: String,
+    pub description: String,
+    pub source: String,
+    pub category: String,
+    pub model: String,
+    pub tools: String,
+    pub installed: bool,
+}
+
+/// The compiled-in catalog JSON (≈1.7 MB), parsed once and cached.
+fn catalog() -> &'static Vec<CatalogEntry> {
+    use std::sync::OnceLock;
+    static CAT: OnceLock<Vec<CatalogEntry>> = OnceLock::new();
+    CAT.get_or_init(|| {
+        let raw = include_str!("../assets/cc-catalog.json");
+        serde_json::from_str(raw).unwrap_or_default()
+    })
+}
+
+fn home_dir() -> Option<std::path::PathBuf> {
+    std::env::var_os("USERPROFILE")
+        .or_else(|| std::env::var_os("HOME"))
+        .map(std::path::PathBuf::from)
+}
+
+/// Where an entry lands under `~/.claude` when installed.
+fn install_path(home: &std::path::Path, kind: &str, name: &str) -> Option<std::path::PathBuf> {
+    // Keep the name a bare file stem — no path separators can escape the dir.
+    if name.is_empty() || name.contains(['/', '\\', ':']) || name.contains("..") {
+        return None;
+    }
+    let base = home.join(".claude");
+    match kind {
+        "agent" => Some(base.join("agents").join(format!("{name}.md"))),
+        "skill" => Some(base.join("skills").join(name).join("SKILL.md")),
+        _ => None,
+    }
+}
+
+fn is_installed(home: &std::path::Path, e: &CatalogEntry) -> bool {
+    install_path(home, &e.kind, &e.name)
+        .map(|p| p.exists())
+        .unwrap_or(false)
+}
+
+/// The whole catalog as light rows (no bodies), with installed-state flagged.
+#[tauri::command]
+pub fn cc_catalog_list() -> ZResult<Vec<CatalogItem>> {
+    let home = home_dir();
+    let rows = catalog()
+        .iter()
+        .map(|e| CatalogItem {
+            id: e.id.clone(),
+            kind: e.kind.clone(),
+            name: e.name.clone(),
+            title: e.title.clone(),
+            description: e.description.clone(),
+            source: e.source.clone(),
+            category: e.category.clone(),
+            model: e.model.clone(),
+            tools: e.tools.clone(),
+            installed: home.as_deref().map(|h| is_installed(h, e)).unwrap_or(false),
+        })
+        .collect();
+    Ok(rows)
+}
+
+/// One entry's full markdown body (for the preview pane).
+#[tauri::command]
+pub fn cc_catalog_body(id: String) -> ZResult<String> {
+    catalog()
+        .iter()
+        .find(|e| e.id == id)
+        .map(|e| e.body.clone())
+        .ok_or_else(|| ZephyrError::NotFound(format!("catalog entry not found: {id}")))
+}
+
+/// Install one catalog entry into `~/.claude` so the live CLI uses it. Writing
+/// the agent/skill file is the real "sync": a terminal `claude` run reads the
+/// same path. Returns the path written.
+#[tauri::command]
+pub fn cc_catalog_install(id: String) -> ZResult<String> {
+    let home = home_dir().ok_or_else(|| ZephyrError::NotFound("no home directory".into()))?;
+    let entry = catalog()
+        .iter()
+        .find(|e| e.id == id)
+        .ok_or_else(|| ZephyrError::NotFound(format!("catalog entry not found: {id}")))?;
+    let path = install_path(&home, &entry.kind, &entry.name)
+        .ok_or_else(|| ZephyrError::InvalidInput("bad entry name".into()))?;
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)
+            .map_err(|e| ZephyrError::Io(format!("create {}: {e}", parent.display())))?;
+    }
+    std::fs::write(&path, &entry.body)
+        .map_err(|e| ZephyrError::Io(format!("write {}: {e}", path.display())))?;
+    Ok(path.to_string_lossy().to_string())
+}
+
+/// Remove an installed entry from `~/.claude`. For a skill the whole folder is
+/// removed; for an agent just the file.
+#[tauri::command]
+pub fn cc_catalog_uninstall(id: String) -> ZResult<bool> {
+    let home = home_dir().ok_or_else(|| ZephyrError::NotFound("no home directory".into()))?;
+    let entry = catalog()
+        .iter()
+        .find(|e| e.id == id)
+        .ok_or_else(|| ZephyrError::NotFound(format!("catalog entry not found: {id}")))?;
+    let path = install_path(&home, &entry.kind, &entry.name)
+        .ok_or_else(|| ZephyrError::InvalidInput("bad entry name".into()))?;
+    if entry.kind == "skill" {
+        if let Some(dir) = path.parent() {
+            if dir.exists() {
+                std::fs::remove_dir_all(dir)
+                    .map_err(|e| ZephyrError::Io(format!("remove {}: {e}", dir.display())))?;
+                return Ok(true);
+            }
+        }
+        return Ok(false);
+    }
+    if path.exists() {
+        std::fs::remove_file(&path)
+            .map_err(|e| ZephyrError::Io(format!("remove {}: {e}", path.display())))?;
+        return Ok(true);
+    }
+    Ok(false)
+}
+
+/// A skill or agent found in someone else's repository.
+///
+/// The bundled catalog covers four curated repos; everything else in the
+/// ecosystem (claude-red's security skills, pg-aiguide, a team's private
+/// collection) lives in arbitrary GitHub repos that Zephyr cannot ship. Scanning
+/// a repo for its SKILL.md / agent markdown is what makes those reachable.
+#[derive(Serialize)]
+pub struct RemoteEntry {
+    pub name: String,
+    /// "skill" when it came from a SKILL.md, "agent" from a frontmatter md.
+    pub kind: String,
+    pub title: String,
+    pub description: String,
+    /// Repo-relative path, shown so the reader can see what they are taking.
+    pub path: String,
+    /// The file's text, so the preview needs no second request.
+    pub body: String,
+}
+
+/// Where a remote repo can be fetched from.
+///
+/// Only GitHub is accepted, and the value is used to BUILD a URL rather than
+/// passed to a shell, so a crafted "repo" cannot become a command. Rejecting
+/// anything with a scheme or whitespace is what keeps that true.
+fn github_slug(repo: &str) -> Option<String> {
+    let r = repo.trim().trim_end_matches('/');
+    let r = r.strip_prefix("https://github.com/").unwrap_or(r);
+    let r = r.strip_prefix("github.com/").unwrap_or(r);
+    if r.is_empty() || r.contains(char::is_whitespace) || r.contains("..") {
+        return None;
+    }
+    let parts: Vec<&str> = r.split('/').collect();
+    if parts.len() < 2 || parts[0].is_empty() || parts[1].is_empty() {
+        return None;
+    }
+    Some(format!("{}/{}", parts[0], parts[1]))
+}
+
+/// List the skills and agents in a GitHub repo, without installing anything.
+///
+/// Reads the repository's file tree over the public API rather than cloning:
+/// a clone of a large repo for a single SKILL.md is minutes of work and disk,
+/// and the reader is only browsing at this point.
+#[tauri::command]
+pub async fn cc_repo_scan(repo: String) -> ZResult<Vec<RemoteEntry>> {
+    let slug = github_slug(&repo)
+        .ok_or_else(|| ZephyrError::InvalidInput("expected owner/repo".into()))?;
+    let url = format!("https://api.github.com/repos/{slug}/git/trees/HEAD?recursive=1");
+
+    let resp = ureq::get(&url)
+        .config()
+        .timeout_global(Some(std::time::Duration::from_secs(60)))
+        .build()
+        .header("Accept", "application/vnd.github+json")
+        .header("User-Agent", "Zephyr")
+        .call()
+        .map_err(|e| ZephyrError::InvalidInput(format!("github: {e}")))?;
+    let mut rb = resp.into_body();
+    let body = rb
+        .read_to_string()
+        .map_err(|e| ZephyrError::Io(e.to_string()))?;
+
+    let v: serde_json::Value =
+        serde_json::from_str(&body).map_err(|e| ZephyrError::InvalidInput(format!("github json: {e}")))?;
+    let Some(tree) = v.get("tree").and_then(|x| x.as_array()) else {
+        return Err(ZephyrError::InvalidInput(
+            "github returned no tree (private repo, or rate limited)".into(),
+        ));
+    };
+
+    /* Only files that ARE a skill or an agent. A repo of 500 markdown files is
+       mostly docs; taking them all would bury the two real skills. */
+    let mut out = Vec::new();
+    for node in tree {
+        let Some(path) = node.get("path").and_then(|x| x.as_str()) else {
+            continue;
+        };
+        let lower = path.to_ascii_lowercase();
+        let kind = if lower.ends_with("skill.md") {
+            "skill"
+        } else if lower.contains("/agents/") && lower.ends_with(".md") {
+            "agent"
+        } else {
+            continue;
+        };
+        /* Cap the number of fetches: each candidate is a separate HTTP request,
+           and a large repo can list hundreds. */
+        if out.len() >= 60 {
+            break;
+        }
+        let name = path
+            .rsplit('/')
+            .next()
+            .unwrap_or(path)
+            .trim_end_matches(".md")
+            .trim_end_matches(".MD");
+        /* A skill's directory name is its identity; SKILL.md is the same
+           filename in every one of them. */
+        let name = if kind == "skill" {
+            path.rsplit('/').nth(1).unwrap_or(name).to_string()
+        } else {
+            name.to_string()
+        };
+        let raw = format!("https://raw.githubusercontent.com/{slug}/HEAD/{path}");
+        /* A file that fails to fetch is skipped, not fatal: one unreadable
+           path in a repo should cost the reader that entry, not the whole
+           scan. */
+        let Ok(resp) = ureq::get(&raw).header("User-Agent", "Zephyr").call() else {
+            continue;
+        };
+        let mut rb = resp.into_body();
+        let Ok(text) = rb.read_to_string() else {
+            continue;
+        };
+        let (title, description) = read_frontmatter(&text);
+        out.push(RemoteEntry {
+            /* `title` first: it falls back to `name`, so reading it after the
+               move would need a clone. */
+            title: title.unwrap_or_else(|| name.clone()),
+            name,
+            kind: kind.to_string(),
+            description: description.unwrap_or_default(),
+            path: path.to_string(),
+            body: text,
+        });
+    }
+    Ok(out)
+}
+
+/// `name:` and `description:` out of a markdown frontmatter block.
+fn read_frontmatter(text: &str) -> (Option<String>, Option<String>) {
+    let Some(rest) = text.strip_prefix("---") else {
+        return (None, None);
+    };
+    let Some(end) = rest.find("
+---") else {
+        return (None, None);
+    };
+    let mut title = None;
+    let mut desc = None;
+    for line in rest[..end].lines() {
+        let Some((k, v)) = line.split_once(':') else {
+            continue;
+        };
+        let v = v.trim().trim_matches('"').trim_matches('\'').to_string();
+        match k.trim() {
+            "name" | "title" if title.is_none() => title = Some(v),
+            "description" => desc = Some(v),
+            _ => {}
+        }
+    }
+    (title, desc)
+}
+
+/// Install one entry fetched from a remote repo.
+///
+/// Validation is the same as the bundled catalog's: a bare name, so it cannot
+/// escape `~/.claude/`. The BODY is re-fetched rather than trusted from the
+/// caller, because the caller is the webview and the file it writes runs as a
+/// skill inside the user's agent.
+#[tauri::command]
+pub async fn cc_repo_install(repo: String, path: String, kind: String) -> ZResult<String> {
+    let slug = github_slug(&repo)
+        .ok_or_else(|| ZephyrError::InvalidInput("expected owner/repo".into()))?;
+    if path.contains("..") || path.starts_with('/') {
+        return Err(ZephyrError::InvalidInput("bad path".into()));
+    }
+    let raw = format!("https://raw.githubusercontent.com/{slug}/HEAD/{path}");
+    let resp = ureq::get(&raw)
+        .header("User-Agent", "Zephyr")
+        .call()
+        .map_err(|e| ZephyrError::InvalidInput(format!("github: {e}")))?;
+    let mut rb = resp.into_body();
+    let text = rb
+        .read_to_string()
+        .map_err(|e| ZephyrError::Io(e.to_string()))?;
+
+    let name = if kind == "skill" {
+        path.rsplit('/').nth(1).unwrap_or("").to_string()
+    } else {
+        path.rsplit('/')
+            .next()
+            .unwrap_or("")
+            .trim_end_matches(".md")
+            .to_string()
+    };
+    let home = home_dir().ok_or_else(|| ZephyrError::NotFound("no home directory".into()))?;
+    let out = install_path(&home, &kind, &name)
+        .ok_or_else(|| ZephyrError::InvalidInput("bad entry name".into()))?;
+    if let Some(parent) = out.parent() {
+        std::fs::create_dir_all(parent).map_err(|e| ZephyrError::Io(e.to_string()))?;
+    }
+    std::fs::write(&out, text).map_err(|e| ZephyrError::Io(e.to_string()))?;
+    Ok(out.to_string_lossy().to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn catalog_parses_and_has_entries() {
+        let c = catalog();
+        assert!(c.len() > 200, "expected a full catalog, got {}", c.len());
+        assert!(c.iter().any(|e| e.kind == "agent"));
+        assert!(c.iter().any(|e| e.kind == "skill"));
+    }
+
+    #[test]
+    fn github_slug_accepts_the_usual_forms() {
+        for input in [
+            "SnailSploit/claude-red",
+            "https://github.com/SnailSploit/claude-red",
+            "https://github.com/SnailSploit/claude-red/",
+            "github.com/timescale/pg-aiguide",
+        ] {
+            assert_eq!(
+                github_slug(input).as_deref(),
+                Some(if input.contains("pg-aiguide") {
+                    "timescale/pg-aiguide"
+                } else {
+                    "SnailSploit/claude-red"
+                }),
+                "failed on {input}"
+            );
+        }
+    }
+
+    #[test]
+    fn github_slug_rejects_anything_that_could_escape() {
+        // The value is used to BUILD a URL, so a scheme, a traversal or a stray
+        // space must not survive - each is a way to reach a host we did not mean.
+        for bad in [
+            "",
+            "   ",
+            "just-a-name",
+            "owner/repo/../../etc",
+            "https://evil.example.com/owner/repo",
+            "owner/repo extra",
+        ] {
+            let got = github_slug(bad);
+            // A full URL to another host is stripped to its last two segments
+            // only when it looks like github.com; anything else must be None.
+            if bad.starts_with("https://evil") {
+                assert!(got.is_none(), "accepted {bad:?} -> {got:?}");
+            } else {
+                assert!(got.is_none() || !got.as_deref().unwrap().contains(".."), "accepted {bad:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn frontmatter_reads_name_and_description() {
+        let t = "---
+name: my-skill
+description: does a thing
+---
+
+# Body";
+        let (n, d) = read_frontmatter(t);
+        assert_eq!(n.as_deref(), Some("my-skill"));
+        assert_eq!(d.as_deref(), Some("does a thing"));
+        // No frontmatter at all is not an error, just no metadata.
+        let (n2, d2) = read_frontmatter("# Just a heading");
+        assert!(n2.is_none() && d2.is_none());
+    }
+
+    #[test]
+    fn install_path_is_sandboxed() {
+        let home = std::path::Path::new("/home/u");
+        assert!(install_path(home, "agent", "../evil").is_none());
+        assert!(install_path(home, "agent", "a/b").is_none());
+        assert_eq!(
+            install_path(home, "agent", "bash-expert").unwrap(),
+            home.join(".claude").join("agents").join("bash-expert.md")
+        );
+        assert_eq!(
+            install_path(home, "skill", "docx").unwrap(),
+            home.join(".claude").join("skills").join("docx").join("SKILL.md")
+        );
+    }
+}
diff --git a/src-tauri/src/cc_plugins.rs b/src-tauri/src/cc_plugins.rs
new file mode 100644
index 0000000..7eb1967
--- /dev/null
+++ b/src-tauri/src/cc_plugins.rs
@@ -0,0 +1,294 @@
+//! Browse, install and remove Claude Code plugins.
+//!
+//! Claude Code keeps the marketplace catalog and the installed set in
+//! `~/.claude/plugins/`. This module reads both so the panel can show what is
+//! available and what is already there, and installs by delegating to the real
+//! `claude plugin` CLI rather than reimplementing the install.
+//!
+//! WHY delegate: installing a plugin means cloning its source (a git repo, a
+//! subdirectory of one, or a plain URL), resolving a ref, writing a manifest
+//! entry and updating `installed_plugins.json` — and every one of those steps is
+//! something the CLI already does, versioned with the CLI itself. A second
+//! implementation here would drift, and would be wrong the first time the plugin
+//! format changed. The CLI is the source of truth for what "installed" means.
+
+use serde::Serialize;
+use serde_json::Value;
+use std::path::PathBuf;
+
+use crate::errors::{ZResult, ZephyrError};
+
+type ZResultT<T> = ZResult<T>;
+
+/// One entry in the marketplace catalog.
+#[derive(Serialize)]
+pub struct CatalogPlugin {
+    /// `name@marketplace` — the identity the CLI uses on the command line.
+    pub id: String,
+    pub name: String,
+    pub marketplace: String,
+    /// Falls back to the marketplace entry's description when the catalog has
+    /// none of its own, because an empty row tells the reader nothing.
+    pub description: String,
+    pub author: String,
+    pub category: String,
+    pub homepage: String,
+    /// Installs recorded across all users, as a rough popularity signal.
+    pub installs: u64,
+    /// How many commands / agents / skills / hooks / MCP servers it brings, so
+    /// the reader can tell a one-command plugin from a large suite.
+    pub commands: usize,
+    pub agents: usize,
+    pub skills: usize,
+    pub hooks: usize,
+    pub mcp: usize,
+    /// Already installed (from `installed_plugins.json`).
+    pub installed: bool,
+    /// Installed AND switched on in settings (only meaningful when installed).
+    pub enabled: bool,
+}
+
+fn home() -> Option<PathBuf> {
+    crate::cli_chat::home_dir()
+}
+
+fn plugins_dir() -> ZResultT<PathBuf> {
+    Ok(home()
+        .ok_or_else(|| ZephyrError::NotFound("no home".into()))?
+        .join(".claude")
+        .join("plugins"))
+}
+
+fn read_json(p: &PathBuf) -> Option<Value> {
+    let s = std::fs::read_to_string(p).ok()?;
+    serde_json::from_str(&s).ok()
+}
+
+/// The set of installed plugin ids (`name@marketplace`).
+fn installed_ids(dir: &PathBuf) -> std::collections::HashSet<String> {
+    let mut out = std::collections::HashSet::new();
+    if let Some(v) = read_json(&dir.join("installed_plugins.json")) {
+        if let Some(map) = v.get("plugins").and_then(|x| x.as_object()) {
+            for k in map.keys() {
+                out.insert(k.clone());
+            }
+        }
+    }
+    out
+}
+
+/// The set of enabled plugin ids, from `settings.json` → `enabledPlugins`.
+fn enabled_ids() -> std::collections::HashSet<String> {
+    let mut out = std::collections::HashSet::new();
+    let Some(h) = home() else { return out };
+    if let Some(v) = read_json(&h.join(".claude").join("settings.json")) {
+        if let Some(map) = v.get("enabledPlugins").and_then(|x| x.as_object()) {
+            for (k, val) in map {
+                if val.as_bool().unwrap_or(false) {
+                    out.insert(k.clone());
+                }
+            }
+        }
+    }
+    out
+}
+
+fn as_str(v: &Value, key: &str) -> String {
+    v.get(key)
+        .and_then(|x| x.as_str())
+        .unwrap_or("")
+        .to_string()
+}
+
+fn count(list: &Value) -> usize {
+    list.as_array().map(|a| a.len()).unwrap_or(0)
+}
+
+/// Every plugin the marketplace offers, with its install state folded in.
+///
+/// Returns an empty list rather than an error when the catalog is absent: a
+/// machine that has never opened the plugin browser legitimately has no cache,
+/// and the panel should say "nothing to show" instead of surfacing a failure
+/// the reader cannot act on.
+#[tauri::command]
+pub fn cc_plugins_catalog() -> ZResultT<Vec<CatalogPlugin>> {
+    let Ok(dir) = plugins_dir() else {
+        return Ok(Vec::new());
+    };
+    let Some(cat) = read_json(&dir.join("plugin-catalog-cache.json")) else {
+        return Ok(Vec::new());
+    };
+    let Some(plugins) = cat
+        .get("catalog")
+        .and_then(|c| c.get("plugins"))
+        .and_then(|p| p.as_object())
+    else {
+        return Ok(Vec::new());
+    };
+
+    let installed = installed_ids(&dir);
+    let enabled = enabled_ids();
+
+    let mut out: Vec<CatalogPlugin> = plugins
+        .iter()
+        .map(|(id, e)| {
+            let me = e.get("marketplace_entry").cloned().unwrap_or(Value::Null);
+            let comp = e.get("components").cloned().unwrap_or(Value::Null);
+            let (name, market) = id.split_once('@').unwrap_or((id.as_str(), ""));
+            /* The catalog's own description is often missing while the
+               marketplace entry has a full one — the panel wants the prose, so
+               either source will do. */
+            let desc = {
+                let a = as_str(&me, "description");
+                if a.is_empty() {
+                    as_str(e, "description")
+                } else {
+                    a
+                }
+            };
+            CatalogPlugin {
+                id: id.clone(),
+                name: name.to_string(),
+                marketplace: market.to_string(),
+                description: desc,
+                author: me
+                    .get("author")
+                    .and_then(|a| a.get("name"))
+                    .and_then(|x| x.as_str())
+                    .unwrap_or("")
+                    .to_string(),
+                category: as_str(&me, "category"),
+                homepage: as_str(&me, "homepage"),
+                installs: e.get("unique_installs").and_then(|x| x.as_u64()).unwrap_or(0),
+                commands: count(comp.get("commands").unwrap_or(&Value::Null)),
+                agents: count(comp.get("agents").unwrap_or(&Value::Null)),
+                skills: count(comp.get("skills").unwrap_or(&Value::Null)),
+                hooks: count(comp.get("hooks").unwrap_or(&Value::Null)),
+                mcp: count(comp.get("mcpServers").unwrap_or(&Value::Null)),
+                installed: installed.contains(id),
+                enabled: enabled.contains(id),
+            }
+        })
+        .collect();
+
+    /* Most-installed first: a browse list is read from the top and the reader
+       is usually after something known-good rather than something obscure. */
+    out.sort_by(|a, b| b.installs.cmp(&a.installs).then(a.name.cmp(&b.name)));
+    Ok(out)
+}
+
+/// Ask the real CLI to install a plugin. Returns its combined output.
+///
+/// The command runs with the same timeout discipline as the rest of the app:
+/// an install clones a repository, so it is slow, but it must not hang forever
+/// with the panel showing a spinner and no way to tell whether anything is
+/// happening.
+#[tauri::command]
+pub async fn cc_plugin_install(id: String) -> ZResultT<String> {
+    if !id.contains('@') || id.contains([' ', '\n', '\r', '\t']) {
+        return Err(ZephyrError::InvalidInput("bad plugin id".into()));
+    }
+    run_cli(vec!["plugin".into(), "install".into(), id]).await
+}
+
+/// Ask the real CLI to remove a plugin.
+#[tauri::command]
+pub async fn cc_plugin_uninstall(id: String) -> ZResultT<String> {
+    if !id.contains('@') || id.contains([' ', '\n', '\r', '\t']) {
+        return Err(ZephyrError::InvalidInput("bad plugin id".into()));
+    }
+    run_cli(vec!["plugin".into(), "uninstall".into(), id]).await
+}
+
+/// Registered marketplaces, so the panel can show where the catalog comes from.
+#[tauri::command]
+pub fn cc_plugin_marketplaces() -> ZResultT<Vec<Value>> {
+    let Ok(dir) = plugins_dir() else {
+        return Ok(Vec::new());
+    };
+    let Some(v) = read_json(&dir.join("known_marketplaces.json")) else {
+        return Ok(Vec::new());
+    };
+    let Some(map) = v.as_object() else {
+        return Ok(Vec::new());
+    };
+    Ok(map
+        .iter()
+        .map(|(name, e)| {
+            let src = e.get("source").cloned().unwrap_or(Value::Null);
+            serde_json::json!({
+                "name": name,
+                /* Report the repo, not the install path: the path is this
+                   machine's business and means nothing to the reader. */
+                "source": src.get("repo").and_then(|x| x.as_str())
+                    .or_else(|| src.get("url").and_then(|x| x.as_str()))
+                    .unwrap_or(""),
+                "updated": e.get("lastUpdated").and_then(|x| x.as_str()).unwrap_or(""),
+            })
+        })
+        .collect())
+}
+
+/// Run `claude <args>` and return its output, bounded by a timeout.
+async fn run_cli(args: Vec<String>) -> ZResultT<String> {
+    let mut cmd = crate::proc::tokio_cmd("claude");
+    cmd.args(&args)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped());
+
+    let fut = cmd.output();
+    let out = match tokio::time::timeout(std::time::Duration::from_secs(180), fut).await {
+        Ok(Ok(o)) => o,
+        Ok(Err(e)) => return Err(ZephyrError::InvalidInput(format!("running claude failed: {e}"))),
+        Err(_) => {
+            return Err(ZephyrError::InvalidInput(
+                "the plugin command did not finish within 3 minutes".into(),
+            ))
+        }
+    };
+
+    let mut text = String::from_utf8_lossy(&out.stdout).to_string();
+    let err = String::from_utf8_lossy(&out.stderr);
+    if !out.status.success() {
+        /* Surface stderr when the command failed — it carries the reason, and a
+           bare "exit 1" tells the reader nothing they can act on. */
+        if !err.trim().is_empty() {
+            text.push('\n');
+            text.push_str(err.trim());
+        }
+        return Err(ZephyrError::InvalidInput(text.trim().to_string()));
+    }
+    Ok(text.trim().to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn as_str_handles_missing_and_wrong_type() {
+        let v = serde_json::json!({ "a": "x", "b": 3 });
+        assert_eq!(as_str(&v, "a"), "x");
+        assert_eq!(as_str(&v, "b"), "");
+        assert_eq!(as_str(&v, "nope"), "");
+    }
+
+    #[test]
+    fn count_only_counts_arrays() {
+        assert_eq!(count(&serde_json::json!([1, 2, 3])), 3);
+        assert_eq!(count(&serde_json::json!([])), 0);
+        assert_eq!(count(&serde_json::json!({ "a": 1 })), 0);
+        assert_eq!(count(&Value::Null), 0);
+    }
+
+    #[test]
+    fn install_id_is_validated() {
+        // The guard exists so a crafted id cannot inject an extra argv entry.
+        for bad in ["nope", "a b@c", "a@b\nc", ""] {
+            let looks_ok = bad.contains('@') && !bad.contains([' ', '\n', '\r', '\t']);
+            assert!(!looks_ok, "{bad:?} should be rejected");
+        }
+        assert!("name@marketplace".contains('@'));
+    }
+}
diff --git a/src-tauri/src/cli_chat.rs b/src-tauri/src/cli_chat.rs
new file mode 100644
index 0000000..645f72b
--- /dev/null
+++ b/src-tauri/src/cli_chat.rs
@@ -0,0 +1,2201 @@
+//! Native-UI hosting for external coding CLIs (Cara B).
+//!
+//! Unlike `cli_agents` (one-shot capture) and the PTY TUI host, this runs the
+//! CLI in its HEADLESS / streaming mode and relays its output as events, so the
+//! frontend can paint it in Zephyr's own chat bubbles instead of a terminal.
+//! Login is still the CLI's own job — the same credentials a terminal run uses.
+//!
+//! v1 supports two CLIs:
+//!   * claude: `claude -p <prompt> --output-format stream-json --verbose`
+//!             (newline-delimited JSON; we extract assistant text deltas)
+//!   * codex:  `codex exec <prompt>` (plain text on stdout)
+
+use std::collections::HashMap;
+use std::process::Stdio;
+use std::sync::{Mutex, OnceLock};
+
+use serde_json::{json, Value};
+use tauri::{AppHandle, Emitter};
+use tokio::io::{AsyncBufReadExt, BufReader};
+
+use crate::errors::{ZResult, ZephyrError};
+
+/// Running sessions, keyed by the frontend request id, so a cancel can kill the
+/// right child.
+fn running() -> &'static Mutex<HashMap<String, tokio::process::Child>> {
+    static RUNNING: OnceLock<Mutex<HashMap<String, tokio::process::Child>>> = OnceLock::new();
+    RUNNING.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+fn emit(app: &AppHandle, payload: Value) {
+    let _ = app.emit("cli-chat-chunk", payload);
+}
+
+/// Which CLI, and how to drive it headlessly.
+struct Headless {
+    bin: &'static str,
+    /// Does stdout speak newline-delimited JSON (claude) or plain text (codex)?
+    json_lines: bool,
+}
+
+fn recipe(agent_id: &str) -> Option<Headless> {
+    match agent_id {
+        "claude" => Some(Headless {
+            bin: "claude",
+            json_lines: true,
+        }),
+        "codex" => Some(Headless {
+            bin: "codex",
+            // Codex stays on plain-text relay for now (rich --json events are
+            // parsed by codex_events_from_line and will be switched on later).
+            json_lines: false,
+        }),
+        _ => None,
+    }
+}
+
+/// Build the argv (minus the binary) for a prompt, folding in the model and the
+/// permission mode the user picked in the composer. Both are optional: an empty
+/// / "default" selection means "let the CLI use its own default", so no flag is
+/// added and the CLI behaves exactly as it would from a plain terminal.
+fn build_args(
+    agent_id: &str,
+    prompt: &str,
+    model: Option<&str>,
+    mode: Option<&str>,
+    resume: Option<&str>,
+) -> Vec<String> {
+    let model = model.filter(|m| !m.is_empty() && *m != "default");
+    let mode = mode.filter(|m| !m.is_empty() && *m != "default");
+    let resume = resume.filter(|m| !m.is_empty());
+    match agent_id {
+        "claude" => {
+            let mut v = vec![
+                "-p".to_string(),
+                prompt.to_string(),
+                "--output-format".into(),
+                "stream-json".into(),
+                "--verbose".into(),
+            ];
+            /*
+             * Continue an existing CLI conversation.
+             *
+             * Verified against the real binary: a session that was told "remember
+             * the name Zephyr" answers "Zephyr." when a later `-p` run passes
+             * `--resume <session-id>`. That makes Zephyr able to pick up a session
+             * started in a terminal — the context the user built up outside this
+             * app is not stranded there.
+             *
+             * Placed before the model/mode flags only for readability; the CLI
+             * does not care about order.
+             */
+            if let Some(r) = resume {
+                v.push("--resume".into());
+                v.push(r.into());
+            }
+            if let Some(m) = model {
+                v.push("--model".into());
+                v.push(m.into());
+            }
+            if let Some(m) = mode {
+                v.push("--permission-mode".into());
+                v.push(m.into());
+            }
+            v
+        }
+        "codex" => {
+            // Codex stays on plain-text relay for now; the rich `--json` event
+            // stream (parsed by codex_events_from_line) is switched on later.
+            let mut v = vec!["exec".to_string()];
+            if let Some(m) = model {
+                v.push("--model".into());
+                v.push(m.into());
+            }
+            v.push(prompt.to_string());
+            v
+        }
+        _ => vec![prompt.to_string()],
+    }
+}
+
+/// Pull assistant text out of one Claude stream-json line. Returns None for the
+/// lines that carry no printable delta (system/init/result bookkeeping).
+///
+/// Kept for the unit tests and as the narrow "answer only" path; the rich
+/// relaying now goes through `claude_events_from_line`, which also surfaces
+/// thinking, tool calls and tool results.
+fn claude_text_from_line(line: &str) -> Option<String> {
+    let v: Value = serde_json::from_str(line).ok()?;
+    // Claude Code stream-json: {"type":"assistant","message":{"content":[{"type":"text","text":"…"}]}}
+    let t = v.get("type")?.as_str()?;
+    if t != "assistant" {
+        return None;
+    }
+    let content = v.get("message")?.get("content")?.as_array()?;
+    let mut out = String::new();
+    for block in content {
+        if block.get("type").and_then(|x| x.as_str()) == Some("text") {
+            if let Some(s) = block.get("text").and_then(|x| x.as_str()) {
+                out.push_str(s);
+            }
+        }
+    }
+    if out.is_empty() {
+        None
+    } else {
+        Some(out)
+    }
+}
+
+/// One structured event ready to emit (the `event` field of a `cli-chat-chunk`
+/// payload). See the frozen contract in the frontend: thinking / text / tool /
+/// error. `tool` carries the full lifecycle (running -> ok/fail) keyed by
+/// `callId` so the UI can upsert one row instead of drawing two.
+fn tool_event(obj: Value) -> Value {
+    json!({ "kind": "tool", "tool": obj })
+}
+
+/// Turn ONE Claude `stream-json` line into zero or more structured events.
+///
+/// The real stream interleaves, in `assistant.message.content[]`:
+///   - {"type":"text","text":…}            -> answer delta
+///   - {"type":"thinking","thinking":…}    -> reasoning delta
+///   - {"type":"tool_use","id","name","input":{…}} -> a tool starting
+/// and in `user.message.content[]`:
+///   - {"type":"tool_result","tool_use_id":…,"content":<str|array>} -> a result
+/// System/init/result bookkeeping lines carry nothing printable and yield [].
+fn claude_events_from_line(line: &str) -> Vec<Value> {
+    claude_events_from_line_skip(line, &mut std::collections::HashSet::new())
+}
+
+/// As `claude_events_from_line`, but tracking which tool calls were folded into
+/// a `todo` event so their results can be skipped.
+///
+/// The parser is per-line because the stream is, and a tool's `tool_use` and its
+/// `tool_result` arrive as two separate lines. That means it cannot decide on
+/// its own whether a result belongs to a call it already turned into a
+/// checklist — so the set of such call ids is threaded in by the caller, which
+/// does see every line.
+///
+/// Without this, every TodoWrite produced a second, nameless tool row carrying
+/// "Todos have been modified successfully": the checklist appeared AND a piece of
+/// machinery appeared next to it, which is exactly the raw-text noise the todo
+/// event was meant to remove.
+fn claude_events_from_line_skip(
+    line: &str,
+    todo_calls: &mut std::collections::HashSet<String>,
+) -> Vec<Value> {
+    let Ok(v) = serde_json::from_str::<Value>(line) else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    match v.get("type").and_then(|x| x.as_str()) {
+        Some("assistant") => {
+            let Some(content) = v.get("message").and_then(|m| m.get("content")).and_then(|c| c.as_array()) else {
+                return out;
+            };
+            for block in content {
+                match block.get("type").and_then(|x| x.as_str()) {
+                    Some("text") => {
+                        if let Some(s) = block.get("text").and_then(|x| x.as_str()) {
+                            if !s.is_empty() {
+                                out.push(json!({ "kind": "text", "text": s }));
+                            }
+                        }
+                    }
+                    Some("thinking") => {
+                        // The reasoning body lives under "thinking"; some builds
+                        // also mirror it under "text", so accept either.
+                        let s = block
+                            .get("thinking")
+                            .and_then(|x| x.as_str())
+                            .or_else(|| block.get("text").and_then(|x| x.as_str()))
+                            .unwrap_or("");
+                        if !s.is_empty() {
+                            out.push(json!({ "kind": "thinking", "text": s }));
+                        }
+                    }
+                    Some("tool_use") => {
+                        let call_id = block.get("id").and_then(|x| x.as_str()).unwrap_or("");
+                        let name = block.get("name").and_then(|x| x.as_str()).unwrap_or("tool");
+                        let input = block.get("input").cloned().unwrap_or(Value::Null);
+                        /*
+                         * A todo write is a PLAN, not an action.
+                         *
+                         * TodoWrite / TaskCreate / TaskUpdate carry the agent's
+                         * task list, and rendering them as ordinary tool rows
+                         * buries the plan inside a collapsed row of JSON — the
+                         * reader sees "TodoWrite" and has to click to discover
+                         * what is about to happen. They are lifted out into a
+                         * `todo` event instead, which the panel paints as a
+                         * checklist. The tool row is not emitted at all: the
+                         * checklist IS the representation of that call.
+                         */
+                        if let Some(todos) = claude_todo_snapshot(name, &input) {
+                            todo_calls.insert(call_id.to_string());
+                            out.push(json!({ "kind": "todo", "items": todos }));
+                            continue;
+                        }
+                        // For file-editing tools, surface the before/after halves
+                        // so the UI draws a real green/red diff (like VSCode's
+                        // Claude Code) instead of raw JSON. The halves come
+                        // straight from the CLI's own tool input.
+                        let (diff_old, diff_new) = claude_edit_halves(name, &input);
+                        let mut tool = json!({
+                            "callId": call_id,
+                            "name": name,
+                            "title": claude_tool_title(name, &input),
+                            "input": pretty_input(&input),
+                            "status": "running",
+                        });
+                        if diff_old.is_some() || diff_new.is_some() {
+                            tool["diffOld"] = json!(diff_old.unwrap_or_default());
+                            tool["diffNew"] = json!(diff_new.unwrap_or_default());
+                            if let Some(p) = input.get("file_path").and_then(|x| x.as_str()) {
+                                tool["path"] = json!(p);
+                            }
+                        }
+                        out.push(tool_event(tool));
+                    }
+                    _ => {}
+                }
+            }
+        }
+        Some("user") => {
+            let Some(content) = v.get("message").and_then(|m| m.get("content")).and_then(|c| c.as_array()) else {
+                return out;
+            };
+            for block in content {
+                if block.get("type").and_then(|x| x.as_str()) == Some("tool_result") {
+                    let call_id = block.get("tool_use_id").and_then(|x| x.as_str()).unwrap_or("");
+                    /* The result of a call already shown as a checklist carries no
+                       information the checklist does not - "Todos have been
+                       modified successfully" is the tool acknowledging itself. */
+                    if todo_calls.contains(call_id) {
+                        continue;
+                    }
+                    let is_err = block.get("is_error").and_then(|x| x.as_bool()).unwrap_or(false);
+                    out.push(tool_event(json!({
+                        "callId": call_id,
+                        "name": "",
+                        "status": if is_err { "fail" } else { "ok" },
+                        "output": tool_result_text(block.get("content")),
+                    })));
+                }
+            }
+        }
+        Some("system") => {
+            /*
+             * The init line names the session.
+             *
+             * Relaying it is what makes `--resume` usable from the UI: without
+             * the id, the panel has no handle on the conversation the CLI just
+             * created, and the next prompt starts a fresh one - losing the
+             * context every tab in this app exists to preserve. Emitted as its
+             * own event rather than folded into a message, because it belongs to
+             * the SESSION, not to any reply.
+             */
+            if v.get("subtype").and_then(|x| x.as_str()) == Some("init") {
+                if let Some(sid) = v.get("session_id").and_then(|x| x.as_str()) {
+                    if !sid.is_empty() {
+                        out.push(json!({ "kind": "session", "sessionId": sid }));
+                    }
+                }
+            }
+        }
+        Some("result") => {
+            /*
+             * The closing line carries the run's token counts and cost.
+             *
+             * It was discarded entirely, which is why the context meter showed
+             * 0% no matter how large the conversation grew: the only frame that
+             * reports the numbers was the one frame nothing read. Verified
+             * against the real binary — the `result` line carries `usage` with
+             * `input_tokens`/`output_tokens` and a `total_cost_usd`.
+             *
+             * Cache reads and writes are folded into `input` rather than
+             * reported separately: they are a cheaper RATE for the same tokens,
+             * and the meter measures how full the window is, not what it cost.
+             */
+            let u = v.get("usage").cloned().unwrap_or(Value::Null);
+            let n = |k: &str| u.get(k).and_then(|x| x.as_u64()).unwrap_or(0);
+            let input = n("input_tokens")
+                + n("cache_read_input_tokens")
+                + n("cache_creation_input_tokens");
+            let output = n("output_tokens");
+            /* A run that reports neither is not a usage report; emitting zeros
+               would read as "this turn was free". */
+            if input > 0 || output > 0 {
+                out.push(json!({
+                    "kind": "usage",
+                    "input": input,
+                    "output": output,
+                    "cost": v.get("total_cost_usd").and_then(|x| x.as_f64()).unwrap_or(0.0),
+                    "turns": v.get("num_turns").and_then(|x| x.as_u64()).unwrap_or(0),
+                }));
+            }
+        }
+        _ => {}
+    }
+    out
+}
+
+/// A readable, one-line target for a Claude tool call: the command for Bash, the
+/// file path for Read/Write/Edit, the pattern for Grep/Glob, else "".
+fn claude_tool_title(name: &str, input: &Value) -> String {
+    let get = |k: &str| input.get(k).and_then(|x| x.as_str()).unwrap_or("");
+    match name {
+        "Bash" | "PowerShell" => get("command").to_string(),
+        "Read" | "Write" | "Edit" | "NotebookEdit" => get("file_path").to_string(),
+        "Grep" => get("pattern").to_string(),
+        "Glob" => get("pattern").to_string(),
+        "WebFetch" => get("url").to_string(),
+        "WebSearch" => get("query").to_string(),
+        "Task" => get("description").to_string(),
+        _ => String::new(),
+    }
+}
+
+/// The before/after text halves for a Claude file-editing tool, so the UI can
+/// render a real diff. Returns `(old, new)`:
+///   * Edit         -> (old_string, new_string)
+///   * Write        -> ("", content)            — a new/overwritten file
+///   * MultiEdit    -> (joined olds, joined news) across every edit
+///   * NotebookEdit -> ("", new_source)
+/// Any other tool yields `(None, None)` and is shown as a plain tool row.
+/// Read a todo list out of a task-tracking tool call, if that is what this is.
+///
+/// Two shapes reach here and both must be understood, because which one a
+/// session uses depends on the CLI's own defaults rather than on anything
+/// Zephyr controls:
+///
+///   * `TodoWrite` carries the WHOLE list every time, each item a
+///     `{content, status, activeForm}`. Sending the complete list is what makes
+///     this one call sufficient — the panel can replace its state outright.
+///   * `TaskCreate` / `TaskUpdate` are the newer per-task tools: one call adds
+///     or changes a single task by `taskId`. They cannot be turned into a
+///     snapshot from one call, so they are reported as a partial update and the
+///     caller merges.
+///
+/// Returns `None` for any other tool, so the ordinary tool-row path is
+/// untouched.
+fn claude_todo_snapshot(name: &str, input: &Value) -> Option<Vec<Value>> {
+    /// `activeForm` is the present-continuous label ("Running tests") shown
+    /// while the step is in progress; `content` is the imperative one ("Run
+    /// tests") shown otherwise. Either may be missing.
+    fn item(content: Option<&str>, active: Option<&str>, status: &str, id: Option<&str>) -> Value {
+        json!({
+            "content": content.unwrap_or(""),
+            "activeForm": active.unwrap_or(""),
+            "status": status,
+            "id": id.unwrap_or(""),
+        })
+    }
+
+    match name {
+        "TodoWrite" => {
+            let arr = input.get("todos").and_then(|x| x.as_array())?;
+            let items = arr
+                .iter()
+                .map(|t| {
+                    item(
+                        t.get("content").and_then(|x| x.as_str()),
+                        t.get("activeForm").and_then(|x| x.as_str()),
+                        t.get("status").and_then(|x| x.as_str()).unwrap_or("pending"),
+                        t.get("id").and_then(|x| x.as_str()),
+                    )
+                })
+                .collect();
+            Some(items)
+        }
+        "TaskCreate" => {
+            let subject = input
+                .get("subject")
+                .or_else(|| input.get("content"))
+                .and_then(|x| x.as_str())?;
+            let active = input.get("activeForm").and_then(|x| x.as_str());
+            let id = input.get("taskId").and_then(|x| x.as_str());
+            Some(vec![item(Some(subject), active, "pending", id)])
+        }
+        "TaskUpdate" => {
+            /* The id field is not reliably spelled: the SDK docs note that
+               Claude Code repairs `id`/`task_id` to `taskId` before execution
+               but that the repair is NOT reflected in the stream we read. So
+               all three spellings are accepted. */
+            let id = input
+                .get("taskId")
+                .or_else(|| input.get("id"))
+                .or_else(|| input.get("task_id"))
+                .and_then(|x| x.as_str())
+                .unwrap_or("");
+            let status = input.get("status").and_then(|x| x.as_str()).unwrap_or("");
+            let active = input.get("activeForm").and_then(|x| x.as_str());
+            let subject = input.get("subject").and_then(|x| x.as_str());
+            /* `deleted` removes the task; passing it through lets the panel
+               drop the row rather than render a task with no state. */
+            Some(vec![item(subject, active, status, Some(id))])
+        }
+        _ => None,
+    }
+}
+
+fn claude_edit_halves(name: &str, input: &Value) -> (Option<String>, Option<String>) {
+    let s = |k: &str| input.get(k).and_then(|x| x.as_str()).map(|x| x.to_string());
+    match name {
+        "Edit" => (s("old_string"), s("new_string")),
+        "Write" => (Some(String::new()), s("content").or(Some(String::new()))),
+        "NotebookEdit" => (Some(String::new()), s("new_source")),
+        "MultiEdit" => {
+            let Some(edits) = input.get("edits").and_then(|x| x.as_array()) else {
+                return (None, None);
+            };
+            let mut old = String::new();
+            let mut new = String::new();
+            for e in edits {
+                if let Some(o) = e.get("old_string").and_then(|x| x.as_str()) {
+                    if !old.is_empty() {
+                        old.push('\n');
+                    }
+                    old.push_str(o);
+                }
+                if let Some(n) = e.get("new_string").and_then(|x| x.as_str()) {
+                    if !new.is_empty() {
+                        new.push('\n');
+                    }
+                    new.push_str(n);
+                }
+            }
+            (Some(old), Some(new))
+        }
+        _ => (None, None),
+    }
+}
+
+/// Pretty-print a tool input object to compact JSON for the expandable body.
+/// A plain string input is returned as-is; null yields "".
+fn pretty_input(input: &Value) -> String {
+    match input {
+        Value::Null => String::new(),
+        Value::String(s) => s.clone(),
+        other => serde_json::to_string_pretty(other).unwrap_or_default(),
+    }
+}
+
+/// Flatten a `tool_result.content`, which Claude sends either as a plain string
+/// or as an array of `{type:"text",text:…}` blocks.
+fn tool_result_text(content: Option<&Value>) -> String {
+    match content {
+        Some(Value::String(s)) => s.clone(),
+        Some(Value::Array(arr)) => {
+            let mut out = String::new();
+            for b in arr {
+                if let Some(s) = b.get("text").and_then(|x| x.as_str()) {
+                    out.push_str(s);
+                }
+            }
+            out
+        }
+        _ => String::new(),
+    }
+}
+
+/// Turn ONE Codex `exec --json` line into zero or more structured events.
+///
+/// Codex emits `item.started` / `item.completed` wrappers around an `item`
+/// whose `type` is the real shape:
+///   - command_execution : a shell call (command / aggregated_output / exit_code / status)
+///   - reasoning          : thinking text
+///   - agent_message      : the final answer text
+///   - file_change        : an edit (path + diff)
+///   - error              : a non-fatal error item
+fn codex_events_from_line(line: &str) -> Vec<Value> {
+    let Ok(v) = serde_json::from_str::<Value>(line) else {
+        return Vec::new();
+    };
+    let phase = v.get("type").and_then(|x| x.as_str()).unwrap_or("");
+    let started = phase == "item.started";
+    let completed = phase == "item.completed";
+    if !started && !completed {
+        return Vec::new();
+    }
+    let Some(item) = v.get("item") else {
+        return Vec::new();
+    };
+    let item_id = item.get("id").and_then(|x| x.as_str()).unwrap_or("");
+    let itype = item.get("type").and_then(|x| x.as_str()).unwrap_or("");
+    let mut out = Vec::new();
+    match itype {
+        "command_execution" => {
+            let command = item.get("command").and_then(|x| x.as_str()).unwrap_or("");
+            let status = if started {
+                "running"
+            } else {
+                match item.get("status").and_then(|x| x.as_str()) {
+                    Some("failed") => "fail",
+                    _ => "ok",
+                }
+            };
+            let exit = item.get("exit_code").cloned().unwrap_or(Value::Null);
+            out.push(tool_event(json!({
+                "callId": item_id,
+                "name": "command_execution",
+                "title": command,
+                "input": command,
+                "status": status,
+                "output": item.get("aggregated_output").and_then(|x| x.as_str()).unwrap_or(""),
+                "exitCode": exit,
+            })));
+        }
+        "file_change" => {
+            // Codex reports a file edit; surface it as a tool with diff halves so
+            // the UI can draw the same diff view as the chat panel.
+            let path = item
+                .get("path")
+                .or_else(|| item.get("file"))
+                .and_then(|x| x.as_str())
+                .unwrap_or("");
+            let status = if started { "running" } else { "ok" };
+            out.push(tool_event(json!({
+                "callId": item_id,
+                "name": "file_change",
+                "title": path,
+                "path": path,
+                "status": status,
+                "diffOld": item.get("old").and_then(|x| x.as_str()).unwrap_or(""),
+                "diffNew": item.get("new").and_then(|x| x.as_str()).unwrap_or(""),
+                "output": item.get("diff").and_then(|x| x.as_str()).unwrap_or(""),
+            })));
+        }
+        "reasoning" if completed => {
+            if let Some(s) = item.get("text").and_then(|x| x.as_str()) {
+                if !s.is_empty() {
+                    out.push(json!({ "kind": "thinking", "text": s }));
+                }
+            }
+        }
+        "agent_message" if completed => {
+            if let Some(s) = item.get("text").and_then(|x| x.as_str()) {
+                if !s.is_empty() {
+                    out.push(json!({ "kind": "text", "text": s }));
+                }
+            }
+        }
+        "error" if completed => {
+            if let Some(s) = item.get("message").and_then(|x| x.as_str()) {
+                out.push(json!({ "kind": "error", "text": s }));
+            }
+        }
+        _ => {}
+    }
+    out
+}
+
+fn resolve_bin(bin: &str) -> ZResult<std::path::PathBuf> {
+    which::which(bin).map_err(|_| {
+        ZephyrError::NotFound(format!("{bin} is not on PATH — install the CLI first"))
+    })
+}
