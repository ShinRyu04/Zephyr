{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Zephyr",
  "version": "1.1.10",
  "identifier": "com.zephyr.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Zephyr",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "focus": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNUY5NDM0M0ZGMEFFNDYKUldSR3J2QS9OSlJmbzRmWld5bEhFTVZqUURGajVwNWp0RFRDUUFjcGg1N2FSbEIzNzhjQTFsc0wK",
      "endpoints": [
        "https://github.com/ShinRyu04/Zephyr/releases/latest/download/latest.json"
      ]
    }
  }
}