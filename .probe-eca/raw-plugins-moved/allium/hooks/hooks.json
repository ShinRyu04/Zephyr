{
  "allium.check-spec": {
    "type": "postToolCall",
    "matcher":
    {"eca__write_file": {"argsMatchers": { "path": [".*\\.allium$"]}},
     "eca__edit_file": {"argsMatchers": { "path": [".*\\.allium$"]}}},
    "visible": true,
    "actions": [
      {
        "type": "shell",
        "shell": "node \"${plugin:root}/hooks/check-spec.mjs\""
      }
    ]
  },
  "allium.loop-trace-pre": {
    "type": "preToolCall",
    "matcher": "eca__spawn_agent",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "shell": "node \"${plugin:root}/hooks/loop-trace.mjs\" pre"
      }
    ]
  },
  "allium.loop-trace-post": {
    "type": "postToolCall",
    "matcher": "eca__spawn_agent",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "shell": "node \"${plugin:root}/hooks/loop-trace.mjs\" post"
      }
    ]
  }
}
