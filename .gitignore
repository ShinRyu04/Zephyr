# Build & tools
node_modules/
dist/
.vite/
src-tauri/target/
src-tauri/gen/
# Verifikator tanda tangan rilis punya target/ sendiri. Tanpa baris ini, 15 MB
# artefak build ikut ter-commit setiap kali ia dibangun ulang.
verifikasi-rilis/target/

# Artefak koleksi ikon (unduhan sekali pakai) — jangan masuk repo
.si-tmp/

# Artefak internal git (rewrite/history) — jangan pernah di-commit
.git-rewrite/

# Direktori uji lokal
.zephyr/

# Kunci & rahasia signing
*.key
*.key.pub
signing-key.txt
.backup-rilis/
secrets.json
secrets.json.bak-*
key-backup-/
key-baru-*/
.build-hold/

# Salinan data %APPDATA%\zephyr yang mungkin dibawa ke folder proyek.
#
# Data user yang sebenarnya hidup di %APPDATA%\zephyr (di luar repo ini), jadi
# baris-baris ini tidak menutup kebocoran apa pun - nilainya nol dari sekarang.
# Gunanya untuk keadaan yang belum terjadi: seseorang menyalin mcp.json ke sini
# untuk men-debug, atau repo ini di-clone ke mesin yang menyimpan setelannya di
# dalam folder proyek. Kalau itu terjadi, `git add -A` akan memasukkannya tanpa
# peringatan - dan token MCP di dalamnya langsung ikut TERIKAT di riwayat, yang
# tidak bisa dihapus dengan commit berikutnya.
mcp.json
mcp.json.bak-*
settings.json
settings.json.bak-*
.env
.env.*
!.env.example

# File lokal / sementara
*.log

# Artefak rilis (installer, sig, latest.json) — tetap lokal, jangan masuk repo
release/
# Skrip probe lokal
scripts/zz-*

# Screenshot & capture pengujian — dokumentasi, bukan bagian dari aplikasi
shot-*.png
side-*.png
status-*.png
final*.png
cek-ui.jpg
gh-menu.png
vscode-menu.png

# Berkas kerja audit/terjemahan sekali pakai (root)
_*.json
_*.txt

# Salinan catatan rilis lama — catatan resmi hidup di release/<versi>/
RELEASE_NOTES_v*.md

# Cache Python & berkas uji sementara
__pycache__/
*.pyc

# Hasil uji sekali pakai — dibaca scripts/run-all-verify.mjs, bukan bagian aplikasi
verify-all.json
verify-all.txt

# Folder sementara yang dibuat harness uji (v4-folder-<timestamp>, v6-pindah-*, dst.)
v4-folder-*
v6-pindah-*
testfiles/v9-replace-*

# Scratch verification artifacts (screenshots, one-off probes)
scripts/_*.mjs
scripts/_*.png

# Files a verification agent is asked to create in the working folder
satu.txt
dua.txt
tiga.txt
s1.txt
s2.txt
s3.txt
s4.txt
.revtmp/
